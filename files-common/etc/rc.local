#!/bin/sh
#
# Ничего не добавляйте сюда.
#
# /etc/rc.local перечислен в /lib/upgrade/keep.d, то есть sysupgrade его
# сохраняет. На уже прошитом роутере он остаётся тем, с которым устройство
# прошили первый раз, и никакая последующая прошивка его не меняет —
# всё, что здесь написано, до парка не доедет.
#
# Поэтому вся загрузочная логика живёт в /usr/bin/titan_boot.sh: /usr/bin
# в keep.d не входит и приезжает из образа целиком. Правьте там.

if [ -x /usr/bin/titan_boot.sh ]; then
    /usr/bin/titan_boot.sh
else
    # Молчать тут нельзя: без titan_boot.sh роутер останется без пароля
    # root и без удалённого доступа, а снаружи будет выглядеть здоровым.
    logger -t rc.local "нет /usr/bin/titan_boot.sh — образ собран неполно"
fi

exit 0
