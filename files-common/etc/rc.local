#!/bin/sh

# confdir из /etc/config/dhcp обязан существовать, иначе dnsmasq не
# стартует вообще и валится в crash loop. Каталог держится на одном
# файле atlanta.conf — если тот пропал, каталог исчезает вместе с ним.
mkdir -p /etc/dnsmasq.d

MAC=$(cat /sys/class/net/br-lan/address 2>/dev/null | tr -d ':' | tr 'A-F' 'a-f')
if [ -z "$MAC" ]; then
    logger -t rc.local "нет MAC br-lan — пароль и FRP не настроены"
    exit 0
fi

# ── Пароль root по MAC ───────────────────────────────────────────
# Сбой openssl не должен мешать настройке FRP: иначе роутер молча
# останется без удалённого доступа, и заметить это будет нечем.
PASS=$(printf '%stests' "$MAC" | sha256sum | cut -c1-16)
HASH=$(openssl passwd -6 "$PASS" 2>/dev/null)
if [ -n "$HASH" ]; then
    sed -i "s|^root:[^:]*:|root:${HASH}:|" /etc/shadow
    echo "$PASS" > /tmp/root_pass.txt
else
    logger -t rc.local "openssl не отработал — пароль root не обновлён"
fi

# ── FRP конфиг с MAC ─────────────────────────────────────────────
mkdir -p /etc/frp
cat > /etc/frp/frpc.ini << EOF
[common]
server_addr = frp.pandora361.online
server_port = 8443
token = 21658aa79e70daf3a9e7ededa24855dcdf791a8606a4da6f8d7cb594513202d2
login_fail_exit = false

[luci${MAC}]
type = stcp
role = server
use_encryption = true
use_compression = false
local_ip = 127.0.0.1
local_port = 80
sk = 27555c1d65fc7d8b4b26f95e6df64ec54b41246bd805fea4e0a96240568ea4fb

[ssh${MAC}]
type = stcp
role = server
use_encryption = true
use_compression = false
local_ip = 127.0.0.1
local_port = 22
sk = 27555c1d65fc7d8b4b26f95e6df64ec54b41246bd805fea4e0a96240568ea4fb
EOF

/etc/init.d/frpc restart

# ── Проверка таблицы nftables после загрузки ─────────────────────
# Сборка правил PassWall при старте регулярно срывается: остаётся
# таблица без хук-цепочек, трафик идёт мимо туннеля, у клиентов нет DNS.
# Само это не выправляется — слепок сломанной таблицы лежит в
# PSW_RULE.nft, и каждый firewall restart её воспроизводит.
#
# Чинить умеет titan_pw_restart.sh, но до сих пор до него доходило только
# через watchdog: тот ждёт 300 секунд аптайма плюс свою минуту в кроне,
# итого до десяти минут неработающего роутера после каждой перезагрузки.
# А перезагрузка бывает и еженедельная по крону, и после каждого OTA.
#
# Здесь проверяем сами через полторы минуты — к этому времени PassWall
# уже отработал. В фоне, чтобы не задерживать загрузку.
{
    sleep 90
    if [ -x /usr/bin/titan_pw_restart.sh ] && nft list table inet passwall >/dev/null 2>&1; then
        for chain in dstnat mangle_prerouting mangle_output nat_output; do
            if ! nft list chain inet passwall "$chain" >/dev/null 2>&1; then
                logger -t rc.local "таблица passwall недостроена после загрузки — чиним"
                /usr/bin/titan_pw_restart.sh -f "проверка после загрузки"
                break
            fi
        done
    fi
} </dev/null >/dev/null 2>&1 &

exit 0
