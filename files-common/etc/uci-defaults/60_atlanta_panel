cat <<'EOF' > /tmp/install_titan_panel_v2.sh
#!/bin/sh
set -eu

# ════════════════════════════════════════════════════════════════
#  Titan Router — Installer v2
#  Первичная установка: WiFi, LAN, пароль, панель
# ════════════════════════════════════════════════════════════════

# ── Цветовой вывод ──────────────────────────────────────────────
C0='\033[0m'; CB='\033[1;36m'; CG='\033[1;32m'; CY='\033[1;33m'; CR='\033[1;31m'
step(){ printf "${CB}━━━ %s ━━━${C0}\n" "$*"; }
ok(){   printf "  ${CG}✔  %s${C0}\n" "$*"; }
info(){ printf "  ${CY}ℹ  %s${C0}\n" "$*"; }

printf '\n'
printf "${CB}╔══════════════════════════════════════════╗${C0}\n"
printf "${CB}║      🚀  Titan Router — Installer v2      ║${C0}\n"
printf "${CB}╚══════════════════════════════════════════╝${C0}\n\n"

CGI_DIR="/www/cgi-bin"
PANEL="$CGI_DIR/panel"
CONF="/etc/config/atl_panel"
LAN_IP="192.168.14.1"
LAN_MASK="255.255.255.0"
WIFI_SSID_24="Titan-2.4"
WIFI_SSID_5="Titan-5"
# При первой прошивке Wi-Fi открытый (без пароля) — клиент задаёт пароль в мастере

# ── Чистая прошивка или обновление ──────────────────────────────
# Маркер перечислен в /etc/sysupgrade.conf, поэтому переживает
# sysupgrade с сохранением настроек. Нет маркера — роутер прошит
# начисто, ставим значения по умолчанию. Есть — на роутере уже есть
# настройки клиента, и Wi-Fi, пароль панели и LAN трогать нельзя.
MARKER="/etc/titan_installed"
if [ -f "$MARKER" ]; then FRESH=0; else FRESH=1; fi

# ── [1/8] Директории ────────────────────────────────────────────
step "[1/8] Подготовка окружения"
mkdir -p "$CGI_DIR"
mkdir -p /etc/config
ok "Директории созданы"

# ── [2/8] UCI-конфиг ────────────────────────────────────────────
step "[2/8] Проверяем UCI-конфигурацию"
if [ -s "$CONF" ]; then
  ok "Конфиг панели уже есть — логин и пароль клиента сохранены"
else
cat >"$CONF" <<'UCI'
config atl_panel 'main'
  option user 'admin'
  option pass 'admin'
UCI
  ok "UCI-конфиг создан"
fi

# ota_url добавляем отдельно: на роутерах, обновлённых с сохранением
# настроек, конфиг остаётся прежний и новой опции в нём нет.
uci -q get atl_panel.main.ota_url >/dev/null 2>&1 || {
  uci -q set atl_panel.main.ota_url=''
  uci -q commit atl_panel
}

# Ручное обновление через routeratl/update.sh убрано, прошивку раздаёт
# titan_ota.sh. Опции остаются в конфигах уже прошитых роутеров —
# /etc/config переживает sysupgrade, из образа удаление не доедет.
if uci -q get atl_panel.main.upd_script_url >/dev/null 2>&1 \
   || uci -q get atl_panel.main.upd_version_url >/dev/null 2>&1; then
  uci -q delete atl_panel.main.upd_script_url
  uci -q delete atl_panel.main.upd_version_url
  uci -q commit atl_panel
  rm -f /etc/atl_panel_update_state 2>/dev/null
  ok "Убраны адреса старого ручного обновления"
fi

# Адреса списков задаёт блок ниже — здесь только режим. Разъезжаться им
# нельзя: при proxy с этими списками весь российский трафик ушёл бы в VPN.
if [ "$(uci -q get passwall.@global[0].chn_list 2>/dev/null)" = "proxy" ]; then
  uci -q set passwall.@global[0].chn_list='direct'
  uci -q commit passwall
  ok "PassWall: chn_list переведён в direct"
fi

# ── Выбранный узел ───────────────────────────────────────────────
# PassWall 26.8.26 переименовал tcp_node в node и удалил udp_node —
# migrate_option в его собственном uci-defaults. Отрабатывает это на
# первой загрузке после прошивки, так что роутер оказывается с пустым
# tcp_node, а всё наше, что читало старое имя, видит пустоту.
#
# Здесь чиним обе беды разом: переносим значение, если миграция ещё не
# прошла, и подставляем балансировщик, если узел пуст или указывает на
# исчезнувшую секцию (так бывает после обновления подписки).
PW_NODE="$(uci -q get passwall.@global[0].node 2>/dev/null || true)"
[ -n "${PW_NODE:-}" ] || PW_NODE="$(uci -q get passwall.@global[0].tcp_node 2>/dev/null || true)"
PW_NODE_OK=0
if [ -n "${PW_NODE:-}" ] && uci -q get passwall."$PW_NODE" >/dev/null 2>&1; then
  PW_NODE_OK=1
fi
if [ "$PW_NODE_OK" = 0 ]; then
  # Балансировщик ищем по протоколу — имя приходит из подписки и меняется.
  PW_NODE="$(uci -q show passwall 2>/dev/null \
    | sed -n "s/^passwall\.\([^.]*\)\.protocol='_balancing'\$/\1/p" | head -1)"
  [ -n "${PW_NODE:-}" ] || PW_NODE="$(uci -q show passwall 2>/dev/null \
    | sed -n "s/^passwall\.\([^.]*\)\.remarks='TitanSwitch'\$/\1/p" | head -1)"
fi
if [ -n "${PW_NODE:-}" ] \
   && [ "$(uci -q get passwall.@global[0].node 2>/dev/null || true)" != "$PW_NODE" ]; then
  uci -q set passwall.@global[0].node="$PW_NODE" || true
  uci -q commit passwall || true
  ok "PassWall: активный узел — $PW_NODE"
fi

# ── Три списка, все со своего зеркала ────────────────────────────
# Раскладка такая:
#   chnlist  = direct-domains.lst — российские домены мимо туннеля
#   chnroute = direct-ip.lst      — российские подсети мимо туннеля
#   gfwlist  = proxy-domains.lst  — наше, чему туннель нужен вопреки
#
# gfwlist переиспользован не по названию: это единственный список
# PassWall, который тянется по URL и всегда уходит в туннель, у него
# нет переключателя direct/proxy. Правила применяются раньше chnlist,
# поэтому домен на .ru из этого файла перебьёт общий direct.
#
# Адрес на raw.githubusercontent убран: GitHub замедлен, и когда он
# отвечает по минуте, обновление списка целиком уходит в таймаут.
#
# Заодно выключаем Direct List: это отдельный от chnlist набор
# (/usr/share/passwall/rules/direct_host), в нём лежит один router.test,
# пользы никакой, а его правила идут ещё раньше gfwlist.
#
# /etc/config/passwall переживает sysupgrade, поэтому из образа правка
# до работающих роутеров не доедет — приводим к нужному виду здесь.
# Установщик идёт под set -e, а uci на отсутствующей секции возвращает
# ошибку — отсюда || true на каждой записи.
LISTS_BASE="https://vbotrouters.titanvps.click/lists"
LISTS_FIXED=0
URLS_FIXED=0
for _pair in \
  "chnlist_url=$LISTS_BASE/direct-domains.lst" \
  "chnroute_url=$LISTS_BASE/direct-ip.lst" \
  "gfwlist_url=$LISTS_BASE/proxy-domains.lst"
do
  _opt="${_pair%%=*}"
  _want="${_pair#*=}"
  _cur="$(uci -q get passwall.@global_rules[0].$_opt 2>/dev/null || true)"
  if [ "$_cur" != "$_want" ]; then
    uci -q delete passwall.@global_rules[0].$_opt 2>/dev/null || true
    uci -q add_list passwall.@global_rules[0].$_opt="$_want" || true
    LISTS_FIXED=1
    URLS_FIXED=1
  fi
done

# Флаги: gfwlist качаем и применяем, Direct List выключен.
for _pair in \
  "global_rules:gfwlist_update:1" \
  "global:use_gfw_list:1" \
  "global:use_direct_list:0"
do
  _sec="@$(echo "$_pair" | cut -d: -f1)[0]"
  _opt="$(echo "$_pair" | cut -d: -f2)"
  _want="$(echo "$_pair" | cut -d: -f3)"
  if [ "$(uci -q get passwall.$_sec.$_opt 2>/dev/null || true)" != "$_want" ]; then
    uci -q set passwall.$_sec.$_opt="$_want" || true
    LISTS_FIXED=1
  fi
done

# Автообновление списков: Loop Mode раз в 12 часов средствами самого
# PassWall. В конфиге лежали auto_update, week_update и interval_update —
# имена из старых версий, эта читает update_week_mode и
# update_interval_mode, поэтому режим показывался как Disable и
# расписание не работало вовсе.
if [ "$(uci -q get passwall.@global_rules[0].update_week_mode 2>/dev/null)" != "8" ] \
   || [ "$(uci -q get passwall.@global_rules[0].update_interval_mode 2>/dev/null)" != "12" ]; then
  uci -q set passwall.@global_rules[0].update_week_mode='8' || true
  uci -q set passwall.@global_rules[0].update_interval_mode='12' || true
  uci -q delete passwall.@global_rules[0].auto_update 2>/dev/null || true
  uci -q delete passwall.@global_rules[0].week_update 2>/dev/null || true
  uci -q delete passwall.@global_rules[0].interval_update 2>/dev/null || true
  LISTS_FIXED=1
fi
if [ "$LISTS_FIXED" = 1 ]; then
  uci -q commit passwall || true
  ok "PassWall: три списка со своего зеркала, обновление раз в 12 часов"
fi

# Сменился адрес — значит лежащий рядом скачанный файл набран из другого
# источника, и содержимое теперь просто неверное. На стенде так и вышло:
# планировщик был мёртв из-за старых имён опций, обновление ни разу не
# отработало, и в chnlist остались дефолтные китайские домены — 112 тысяч
# штук вместо тысячи наших. Мало того что маршрутизация получалась
# обратной, так каждый перезапуск PassWall ещё и перемалывал этот том.
#
# Поэтому при смене адреса чистим. Окно без списка неопасно: до первой
# закачки всё уходит в туннель по tcp_proxy_mode, то есть работает, просто
# без прямых исключений. Заберёт их titan_lists_update.sh на подъёме WAN,
# он там же и дожидается ответа зеркала.
if [ "$URLS_FIXED" = 1 ]; then
  rm -f /usr/share/passwall/rules/chnlist \
        /usr/share/passwall/rules/chnroute \
        /usr/share/passwall/rules/gfwlist 2>/dev/null || true
  info "Списки прежнего источника удалены, скачаются заново"
fi

# Скрипт обновления списков при подъёме WAN — расписание раз в 12 часов
# держит сам PassWall, здесь только обработчик hotplug из образа.
step "[+] Проверяем обновление списков маршрутизации"
if [ -s /usr/bin/titan_lists_update.sh ]; then
  chmod 0755 /usr/bin/titan_lists_update.sh
  ok "titan_lists_update.sh на месте"
else
  info "ВНИМАНИЕ: /usr/bin/titan_lists_update.sh отсутствует — образ собран неполно"
fi
if [ -s /etc/hotplug.d/iface/20_titan_lists ]; then
  chmod 0755 /etc/hotplug.d/iface/20_titan_lists
else
  info "ВНИМАНИЕ: hotplug.d/iface/20_titan_lists отсутствует"
fi

# Общая точка перезапуска PassWall и ловушка всплесков нагрузки.
step "[+] Проверяем защиту от лавины перезапусков"
for f in /usr/bin/titan_pw_restart.sh /usr/bin/titan_loadwatch.sh; do
  if [ -s "$f" ]; then
    chmod 0755 "$f"
  else
    info "ВНИМАНИЕ: $f отсутствует — образ собран неполно"
  fi
done
[ -f /etc/titan_load.log ] || : > /etc/titan_load.log 2>/dev/null || true
ok "titan_pw_restart.sh и titan_loadwatch.sh на месте"

# PassWall 26.8.26 при tcp_proxy_mode=disable не создаёт правил
# перенаправления вовсе: xray работает, а трафик идёт мимо туннеля,
# и внешне это выглядит как исправный роутер без VPN. Значение было
# неверным и раньше, просто 26.5.11 это переживала.
# Конфиг passwall сохраняется при обновлении, поэтому на уже
# настроенных роутерах чиним отдельно.
PW_FIXED=0
for o in tcp_proxy_mode udp_proxy_mode; do
  if [ "$(uci -q get passwall.@global[0].$o 2>/dev/null)" = "disable" ]; then
    uci -q set passwall.@global[0].$o='proxy'
    PW_FIXED=1
  fi
done
if [ "$PW_FIXED" = 1 ]; then
  uci -q commit passwall
  ok "PassWall: режим disable заменён на proxy"
fi

# /etc/sysupgrade.conf тоже сохраняется при обновлении, поэтому новые
# строки из образа до уже работающих роутеров не доезжают — как и с
# crontabs. Дописываем недостающие, не трогая чужие.
for f in \
  "/etc/titan_installed" \
  "/etc/titan_ota_state" \
  "/etc/titan_ota_status" \
  "/etc/titan_load.log"
do
  grep -qxF "$f" /etc/sysupgrade.conf 2>/dev/null || echo "$f" >> /etc/sysupgrade.conf
done

# ── [3/8] CGI-скрипт панели ────────────────────────────────────
# Панель поставляется файлом образа: files-common/www/cgi-bin/panel.
# Раньше её тело лежало здесь heredoc'ом и попадало только в overlay,
# поэтому не обновлялось вместе с прошивкой.
step "[3/8] Проверяем CGI-скрипт панели"
if [ -s "$PANEL" ]; then
  chmod 0755 "$PANEL"
  ok "Панель на месте"
else
  info "ВНИМАНИЕ: $PANEL отсутствует — образ собран неполно"
fi

# ── [4/8] uhttpd ──────────────────────────────────────────────
step "[4/8] Настраиваем uhttpd"
uci -q set uhttpd.main.cgi_prefix='/cgi-bin'
uci -q delete uhttpd.main.interpreter 2>/dev/null || true
uci -q add_list uhttpd.main.interpreter='.sh=/bin/sh'
uci -q set uhttpd.main.index_page='cgi-bin/panel'
uci -q commit uhttpd
ok "uhttpd настроен"

# ── [5/8] Редирект-страница ───────────────────────────────────
step "[5/8] Проверяем страницу-редирект"
if [ -s /www/index.html ]; then
  ok "index.html на месте"
else
  info "ВНИМАНИЕ: /www/index.html отсутствует"
fi

# ── [5a/8] Инструкция — устанавливается отдельно (instruction.txt) ──
info '[5a/8] Инструкция: запустите instruction.txt отдельно'
# ── [5b/8] Страница /my-mac/ ──────────────────────────────────
step "[5b/8] Устанавливаем страницу /my-mac/"
mkdir -p /www/my-mac
if [ -s /www/cgi-bin/my-mac ]; then
  chmod +x /www/cgi-bin/my-mac
else
  info "ВНИМАНИЕ: /www/cgi-bin/my-mac отсутствует"
fi

[ -s /www/my-mac/index.html ]   || info "ВНИМАНИЕ: /www/my-mac/index.html отсутствует"
ok "Страница /my-mac/ установлена"

# ── [6/8] Wi-Fi ───────────────────────────────────────────────
if [ "$FRESH" = 0 ]; then
step "[6/8] Wi-Fi клиента не трогаем"
info "Роутер уже настроен: SSID и пароль сохранены"
else
step "[6/8] Настраиваем Wi-Fi"
uci -q set wireless.radio0.disabled='0' 2>/dev/null || true
uci -q set wireless.radio1.disabled='0' 2>/dev/null || true

if ! uci -q get wireless.default_radio0 >/dev/null 2>&1; then
  uci -q set wireless.default_radio0=wifi-iface
  uci -q set wireless.default_radio0.device='radio0'
  uci -q set wireless.default_radio0.network='lan'
  uci -q set wireless.default_radio0.mode='ap'
fi
uci -q set wireless.default_radio0.ssid="$WIFI_SSID_24"
# Первая прошивка — открытая сеть без пароля, клиент задаёт пароль в мастере
uci -q set wireless.default_radio0.encryption='none'
uci -q delete wireless.default_radio0.key 2>/dev/null || true
uci -q set wireless.default_radio0.disabled='0' 2>/dev/null || true

if uci -q get wireless.radio1.type >/dev/null 2>&1; then
  if ! uci -q get wireless.default_radio1 >/dev/null 2>&1; then
    uci -q set wireless.default_radio1=wifi-iface
    uci -q set wireless.default_radio1.device='radio1'
    uci -q set wireless.default_radio1.network='lan'
    uci -q set wireless.default_radio1.mode='ap'
  fi
  uci -q set wireless.default_radio1.ssid="$WIFI_SSID_5"
  uci -q set wireless.default_radio1.encryption='none'
  uci -q delete wireless.default_radio1.key 2>/dev/null || true
  uci -q set wireless.default_radio1.disabled='0' 2>/dev/null || true
fi
uci -q commit wireless 2>/dev/null || true
ok "Wi-Fi настроен"
fi

# ── [7/8] Сеть ────────────────────────────────────────────────
step "[7/8] Настраиваем LAN"
if [ "$FRESH" = 1 ]; then
  uci -q set network.lan.ipaddr="$LAN_IP"
  uci -q set network.lan.netmask="$LAN_MASK"
  uci -q commit network
else
  LAN_IP="$(uci -q get network.lan.ipaddr 2>/dev/null || echo "$LAN_IP")"
  info "LAN клиента сохранён: $LAN_IP"
fi
rm -f /www/cgi-bin/atl_netstatus 2>/dev/null || true

# ── Добавляем titan.lan hostname ──────────────────────────────
# 1. /etc/hosts
grep -qF "titan.lan" /etc/hosts 2>/dev/null || echo "$LAN_IP titan.lan" >> /etc/hosts

# 2. dnsmasq address record (работает даже если /etc/hosts не читается)
DNSMASQ_CONF="/etc/dnsmasq.d/atlanta.conf"
mkdir -p /etc/dnsmasq.d 2>/dev/null || true
printf 'address=/titan.lan/%s\n' "$LAN_IP" > "$DNSMASQ_CONF"

# 3. Разрешаем dnsmasq читать из /etc/dnsmasq.d/ и разрешаем rebind для LAN
uci -q set dhcp.@dnsmasq[0].confdir='/etc/dnsmasq.d'
uci -q commit dhcp 2>/dev/null || true

# 4. Добавляем titan.lan в rebind-domain-ok (иначе dnsmasq блокирует LAN-IP ответы)
uci -q get dhcp.@dnsmasq[0].rebind_domain 2>/dev/null | grep -qw 'titan.lan'   || uci -q add_list dhcp.@dnsmasq[0].rebind_domain='titan.lan'
uci -q set dhcp.@dnsmasq[0].rebind_protection='1'
uci -q commit dhcp 2>/dev/null || true
ok "LAN IP: $LAN_IP"


# ── [9/9] Сервисы ─────────────────────────────────────────────
step "[9/9] Перезапускаем сервисы"
/etc/init.d/uhttpd restart >/dev/null 2>&1 || true
info "uhttpd перезапущен"
/etc/init.d/network reload >/dev/null 2>&1 || true
info "Сеть перезагружена (reload, WAN не трогаем)"
/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
info "dnsmasq перезапущен (titan.lan активен)"

# ── [+] Кнопка Reset ──────────────────────────────────────────
# Сам обработчик поставляется образом: files-common/etc/hotplug.d/button.
# Раньше он ещё и дублировался heredoc'ом прямо здесь, копии разошлись —
# поставляемая обещала сброс Wi-Fi на 11111111, встроенная ставила
# открытую сеть. Держим логику в одном файле, тут только проверяем.
step "[+] Проверяем обработчик кнопки Reset"
mkdir -p /etc/hotplug.d/button
if [ -s /etc/hotplug.d/button/00-atlanta ]; then
  chmod +x /etc/hotplug.d/button/00-atlanta
  ok "Обработчик кнопки Reset на месте"
else
  cat > /etc/hotplug.d/button/00-atlanta << 'HOTPLUG'
#!/bin/sh
# Запасной вариант: основной файл не попал в образ
[ "$BUTTON" = "reset" ] || exit 0
[ "$ACTION" = "released" ] || exit 0
if [ "${SEEN:-0}" -ge 3 ]; then
  logger -t titan "СБРОС: панель до заводских"
  uci -q set atl_panel.main.user='admin'
  uci -q set atl_panel.main.pass='admin'
  uci -q delete atl_panel.main.setup_done
  uci -q commit atl_panel
  rm -f /tmp/atl_panel_sid
fi
sleep 1
reboot
HOTPLUG
  chmod +x /etc/hotplug.d/button/00-atlanta
  ok "Обработчик кнопки Reset установлен (запасной)"
fi

# Файл /etc/atl_panel_update_state больше не нужен: панель показывает
# номер сборки из /etc/titan_version, а этот держал вечное «4.1.9».
rm -f /etc/atl_panel_update_state 2>/dev/null || true

step "[+] Чистим лишние задачи cron"
rm -f /usr/bin/youtube_strategy_autoselect.sh 2>/dev/null || true
/etc/init.d/after_passwall stop 2>/dev/null || true
/etc/init.d/after_passwall disable 2>/dev/null || true
# Оставляем только обновление подписки в 4:00 ночи
# Строки watchdog'ов вычищаем тоже: они переезжают на разнесённые минуты,
# а grep ниже добавляет задачу, только когда её ещё нет — со старой
# строкой в файле новое расписание никогда бы не доехало.
grep -vE "youtube_strategy|after_passwall|autoselect|passwall.*subscribe|atl_nightly|vpn_watchdog|dns_watchdog|frpc_watchdog" /etc/crontabs/root > /tmp/atl_cron_tmp 2>/dev/null || true
echo "0 4 * * * lua /usr/share/passwall/subscribe.lua >>/tmp/atl_panel_passwall_update.log 2>&1" >> /tmp/atl_cron_tmp
mv /tmp/atl_cron_tmp /etc/crontabs/root

# Наши задачи на обновлённых роутерах сами не появляются:
# /etc/crontabs/root сохраняется при sysupgrade, и новые строки из
# образа туда не попадают. Дописываем недостающие, не трогая чужие.
# Минуты у watchdog'ов разнесены намеренно и нигде не пересекаются:
#   vpn :05 :15 :25 …   dns :01 :06 :11 …   frp :03 :08 :13 …
# Раньше стояло */10 и */5 — все трое просыпались в одну секунду и на
# общий сбой отвечали втроём разом.
for job in \
  "5-59/10 * * * * /usr/bin/vpn_watchdog.sh" \
  "1-59/5 * * * * /usr/bin/dns_watchdog.sh" \
  "3-59/5 * * * * /usr/bin/frpc_watchdog.sh" \
  "30 4 * * * /usr/bin/titan_ota.sh" \n  "* * * * * /usr/bin/titan_pw_check.sh" \
  "* * * * * /usr/bin/titan_loadwatch.sh"
do
  bin="${job##* }"
  [ -x "$bin" ] || continue
  grep -qF "$bin" /etc/crontabs/root 2>/dev/null || echo "$job" >> /etc/crontabs/root
done
/etc/init.d/cron restart >/dev/null 2>&1 || true
ok "Cron: watchdog'и разведены по минутам, ловушка нагрузки включена"


