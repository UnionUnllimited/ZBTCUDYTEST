cat <<'EOF' > /tmp/install_titan_panel_v2.sh
#!/bin/sh
set -eu

# ════════════════════════════════════════════════════════════════
#  Titan Router — Installer v2
#  Первичная установка: WiFi, LAN, пароль, панель
# ════════════════════════════════════════════════════════════════

# ── Цветовой вывод ──────────────────────────────────────────────
C0='\033[0m'; CB='\033[1;36m'; CG='\033[1;32m'; CY='\033[1;33m'; CR='\033[1;31m'
step(){ printf "${CB}━━━ %s ━━━${C0}\n" "$*"; }
ok(){   printf "  ${CG}✔  %s${C0}\n" "$*"; }
info(){ printf "  ${CY}ℹ  %s${C0}\n" "$*"; }

printf '\n'
printf "${CB}╔══════════════════════════════════════════╗${C0}\n"
printf "${CB}║      🚀  Titan Router — Installer v2      ║${C0}\n"
printf "${CB}╚══════════════════════════════════════════╝${C0}\n\n"

CGI_DIR="/www/cgi-bin"
PANEL="$CGI_DIR/panel"
CONF="/etc/config/atl_panel"
LAN_IP="192.168.14.1"
LAN_MASK="255.255.255.0"
WIFI_SSID_24="Titan-2.4"
WIFI_SSID_5="Titan-5"
# При первой прошивке Wi-Fi открытый (без пароля) — клиент задаёт пароль в мастере

# ── Чистая прошивка или обновление ──────────────────────────────
# Маркер перечислен в /etc/sysupgrade.conf, поэтому переживает
# sysupgrade с сохранением настроек. Нет маркера — роутер прошит
# начисто, ставим значения по умолчанию. Есть — на роутере уже есть
# настройки клиента, и Wi-Fi, пароль панели и LAN трогать нельзя.
MARKER="/etc/titan_installed"
if [ -f "$MARKER" ]; then FRESH=0; else FRESH=1; fi

# ── [1/8] Директории ────────────────────────────────────────────
step "[1/8] Подготовка окружения"
mkdir -p "$CGI_DIR"
mkdir -p /etc/config
ok "Директории созданы"

# ── [2/8] UCI-конфиг ────────────────────────────────────────────
step "[2/8] Проверяем UCI-конфигурацию"
if [ -s "$CONF" ]; then
  ok "Конфиг панели уже есть — логин и пароль клиента сохранены"
else
cat >"$CONF" <<'UCI'
config atl_panel 'main'
  option user 'admin'
  option pass 'admin'
  option upd_version_url 'https://raw.githubusercontent.com/UnionUnllimited/routeratl/refs/heads/main/version.txt'
  option upd_script_url 'https://raw.githubusercontent.com/UnionUnllimited/routeratl/refs/heads/main/update.sh'
UCI
  ok "UCI-конфиг создан"
fi

# ota_url добавляем отдельно: на роутерах, обновлённых с сохранением
# настроек, конфиг остаётся прежний и новой опции в нём нет.
uci -q get atl_panel.main.ota_url >/dev/null 2>&1 || {
  uci -q set atl_panel.main.ota_url=''
  uci -q commit atl_panel
}

# ── [3/8] CGI-скрипт панели ────────────────────────────────────
# Панель поставляется файлом образа: files-common/www/cgi-bin/panel.
# Раньше её тело лежало здесь heredoc'ом и попадало только в overlay,
# поэтому не обновлялось вместе с прошивкой.
step "[3/8] Проверяем CGI-скрипт панели"
if [ -s "$PANEL" ]; then
  chmod 0755 "$PANEL"
  ok "Панель на месте"
else
  info "ВНИМАНИЕ: $PANEL отсутствует — образ собран неполно"
fi

# ── [4/8] uhttpd ──────────────────────────────────────────────
step "[4/8] Настраиваем uhttpd"
uci -q set uhttpd.main.cgi_prefix='/cgi-bin'
uci -q delete uhttpd.main.interpreter 2>/dev/null || true
uci -q add_list uhttpd.main.interpreter='.sh=/bin/sh'
uci -q set uhttpd.main.index_page='cgi-bin/panel'
uci -q commit uhttpd
ok "uhttpd настроен"

# ── [5/8] Редирект-страница ───────────────────────────────────
step "[5/8] Проверяем страницу-редирект"
if [ -s /www/index.html ]; then
  ok "index.html на месте"
else
  info "ВНИМАНИЕ: /www/index.html отсутствует"
fi

# ── [5a/8] Инструкция — устанавливается отдельно (instruction.txt) ──
info '[5a/8] Инструкция: запустите instruction.txt отдельно'
# ── [5b/8] Страница /my-mac/ ──────────────────────────────────
step "[5b/8] Устанавливаем страницу /my-mac/"
mkdir -p /www/my-mac
if [ -s /www/cgi-bin/my-mac ]; then
  chmod +x /www/cgi-bin/my-mac
else
  info "ВНИМАНИЕ: /www/cgi-bin/my-mac отсутствует"
fi

[ -s /www/my-mac/index.html ]   || info "ВНИМАНИЕ: /www/my-mac/index.html отсутствует"
ok "Страница /my-mac/ установлена"

# ── [6/8] Wi-Fi ───────────────────────────────────────────────
if [ "$FRESH" = 0 ]; then
step "[6/8] Wi-Fi клиента не трогаем"
info "Роутер уже настроен: SSID и пароль сохранены"
else
step "[6/8] Настраиваем Wi-Fi"
uci -q set wireless.radio0.disabled='0' 2>/dev/null || true
uci -q set wireless.radio1.disabled='0' 2>/dev/null || true

if ! uci -q get wireless.default_radio0 >/dev/null 2>&1; then
  uci -q set wireless.default_radio0=wifi-iface
  uci -q set wireless.default_radio0.device='radio0'
  uci -q set wireless.default_radio0.network='lan'
  uci -q set wireless.default_radio0.mode='ap'
fi
uci -q set wireless.default_radio0.ssid="$WIFI_SSID_24"
# Первая прошивка — открытая сеть без пароля, клиент задаёт пароль в мастере
uci -q set wireless.default_radio0.encryption='none'
uci -q delete wireless.default_radio0.key 2>/dev/null || true
uci -q set wireless.default_radio0.disabled='0' 2>/dev/null || true

if uci -q get wireless.radio1.type >/dev/null 2>&1; then
  if ! uci -q get wireless.default_radio1 >/dev/null 2>&1; then
    uci -q set wireless.default_radio1=wifi-iface
    uci -q set wireless.default_radio1.device='radio1'
    uci -q set wireless.default_radio1.network='lan'
    uci -q set wireless.default_radio1.mode='ap'
  fi
  uci -q set wireless.default_radio1.ssid="$WIFI_SSID_5"
  uci -q set wireless.default_radio1.encryption='none'
  uci -q delete wireless.default_radio1.key 2>/dev/null || true
  uci -q set wireless.default_radio1.disabled='0' 2>/dev/null || true
fi
uci -q commit wireless 2>/dev/null || true
ok "Wi-Fi настроен"
fi

# ── [7/8] Сеть ────────────────────────────────────────────────
step "[7/8] Настраиваем LAN"
if [ "$FRESH" = 1 ]; then
  uci -q set network.lan.ipaddr="$LAN_IP"
  uci -q set network.lan.netmask="$LAN_MASK"
  uci -q commit network
else
  LAN_IP="$(uci -q get network.lan.ipaddr 2>/dev/null || echo "$LAN_IP")"
  info "LAN клиента сохранён: $LAN_IP"
fi
rm -f /www/cgi-bin/atl_netstatus 2>/dev/null || true

# ── Добавляем titan.lan hostname ──────────────────────────────
# 1. /etc/hosts
grep -qF "titan.lan" /etc/hosts 2>/dev/null || echo "$LAN_IP titan.lan" >> /etc/hosts

# 2. dnsmasq address record (работает даже если /etc/hosts не читается)
DNSMASQ_CONF="/etc/dnsmasq.d/atlanta.conf"
mkdir -p /etc/dnsmasq.d 2>/dev/null || true
printf 'address=/titan.lan/%s\n' "$LAN_IP" > "$DNSMASQ_CONF"

# 3. Разрешаем dnsmasq читать из /etc/dnsmasq.d/ и разрешаем rebind для LAN
uci -q set dhcp.@dnsmasq[0].confdir='/etc/dnsmasq.d'
uci -q commit dhcp 2>/dev/null || true

# 4. Добавляем titan.lan в rebind-domain-ok (иначе dnsmasq блокирует LAN-IP ответы)
uci -q get dhcp.@dnsmasq[0].rebind_domain 2>/dev/null | grep -qw 'titan.lan'   || uci -q add_list dhcp.@dnsmasq[0].rebind_domain='titan.lan'
uci -q set dhcp.@dnsmasq[0].rebind_protection='1'
uci -q commit dhcp 2>/dev/null || true
ok "LAN IP: $LAN_IP"


# ── [9/9] Сервисы ─────────────────────────────────────────────
step "[9/9] Перезапускаем сервисы"
/etc/init.d/uhttpd restart >/dev/null 2>&1 || true
info "uhttpd перезапущен"
/etc/init.d/network reload >/dev/null 2>&1 || true
info "Сеть перезагружена (reload, WAN не трогаем)"
/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
info "dnsmasq перезапущен (titan.lan активен)"

# ── [+] Кнопка Reset ──────────────────────────────────────────
# Сам обработчик поставляется образом: files-common/etc/hotplug.d/button.
# Раньше он ещё и дублировался heredoc'ом прямо здесь, копии разошлись —
# поставляемая обещала сброс Wi-Fi на 11111111, встроенная ставила
# открытую сеть. Держим логику в одном файле, тут только проверяем.
step "[+] Проверяем обработчик кнопки Reset"
mkdir -p /etc/hotplug.d/button
if [ -s /etc/hotplug.d/button/00-atlanta ]; then
  chmod +x /etc/hotplug.d/button/00-atlanta
  ok "Обработчик кнопки Reset на месте"
else
  cat > /etc/hotplug.d/button/00-atlanta << 'HOTPLUG'
#!/bin/sh
# Запасной вариант: основной файл не попал в образ
[ "$BUTTON" = "reset" ] || exit 0
[ "$ACTION" = "released" ] || exit 0
if [ "${SEEN:-0}" -ge 3 ]; then
  logger -t titan "СБРОС: панель до заводских"
  uci -q set atl_panel.main.user='admin'
  uci -q set atl_panel.main.pass='admin'
  uci -q delete atl_panel.main.setup_done
  uci -q commit atl_panel
  rm -f /tmp/atl_panel_sid
fi
sleep 1
reboot
HOTPLUG
  chmod +x /etc/hotplug.d/button/00-atlanta
  ok "Обработчик кнопки Reset установлен (запасной)"
fi

# ── Убираем дублирующий after_passwall из автозапуска ─────────
# ── Инициализируем файл версии если отсутствует ───────────────
[ -s /etc/atl_panel_update_state ] || echo "4.1.9" > /etc/atl_panel_update_state
ok "Версия панели инициализирована"

step "[+] Чистим лишние задачи cron"
rm -f /usr/bin/youtube_strategy_autoselect.sh 2>/dev/null || true
/etc/init.d/after_passwall stop 2>/dev/null || true
/etc/init.d/after_passwall disable 2>/dev/null || true
# Оставляем только обновление подписки в 4:00 ночи
grep -vE "youtube_strategy|after_passwall|autoselect|passwall.*subscribe|atl_nightly" /etc/crontabs/root > /tmp/atl_cron_tmp 2>/dev/null || true
echo "0 4 * * * lua /usr/share/passwall/subscribe.lua >>/tmp/atl_panel_passwall_update.log 2>&1" >> /tmp/atl_cron_tmp
mv /tmp/atl_cron_tmp /etc/crontabs/root

# Наши задачи на обновлённых роутерах сами не появляются:
# /etc/crontabs/root сохраняется при sysupgrade, и новые строки из
# образа туда не попадают. Дописываем недостающие, не трогая чужие.
for job in \
  "*/10 * * * * /usr/bin/vpn_watchdog.sh" \
  "*/5 * * * * /usr/bin/dns_watchdog.sh" \
  "*/5 * * * * /usr/bin/frpc_watchdog.sh" \
  "30 4 * * * /usr/bin/titan_ota.sh"
do
  bin="${job##* }"
  [ -x "$bin" ] || continue
  grep -qF "$bin" /etc/crontabs/root 2>/dev/null || echo "$job" >> /etc/crontabs/root
done
/etc/init.d/cron restart >/dev/null 2>&1 || true
ok "Cron: обновление подписки в 04:00"


# ── Маркер установки ─────────────────────────────────────────
# Следующий запуск по нему поймёт, что роутер уже настроен.
date > "$MARKER"

# ── Финальный баннер ─────────────────────────────────────────
printf '\n'
printf "${CG}╔══════════════════════════════════════════╗${C0}\n"
printf "${CG}║       ✅  TITAN PANEL УСТАНОВЛЕНА!       ║${C0}\n"
printf "${CG}╠══════════════════════════════════════════╣${C0}\n"
printf "${CG}║${C0}  Адрес панели:  ${CB}http://%s/${C0}%*s${CG}║${C0}\n" "$LAN_IP" "$((20 - ${#LAN_IP}))" ""
printf "${CG}║${C0}  Логин:         ${CB}admin${C0}%*s${CG}║${C0}\n" 18 ""
printf "${CG}║${C0}  Пароль:        ${CB}admin${C0}%*s${CG}║${C0}\n" 18 ""
printf "${CG}╠══════════════════════════════════════════╣${C0}\n"
printf "${CG}║${C0}  Wi-Fi 2.4 ГГц: ${CB}%s${C0}%*s${CG}║${C0}\n" "$WIFI_SSID_24" "$((25 - ${#WIFI_SSID_24}))" ""
printf "${CG}║${C0}  Wi-Fi 5 ГГц:   ${CB}%s${C0}%*s${CG}║${C0}\n" "$WIFI_SSID_5" "$((26 - ${#WIFI_SSID_5}))" ""
printf "${CG}║${C0}  Пароль Wi-Fi:  ${CB}без пароля${C0}%*s${CG}║${C0}\n" 15 ""
printf "${CG}╠══════════════════════════════════════════╣${C0}\n"
printf "${CG}║${C0}  Адрес (hostname): ${CB}http://titan.lan/${C0}%*s${CG}║${C0}\n" 15 ""
printf "${CG}║${C0}  MAC страница:      ${CB}http://titan.lan/my-mac/${C0}%*s${CG}║${C0}\n" 6 ""
printf "${CG}║${C0}  ${CY}⚠ Смените пароль панели после входа!${C0}   ${CG}║${C0}\n"
printf "${CG}╠══════════════════════════════════════════╣${C0}\n"
printf "${CG}║${C0}  Кнопка Reset: < 3с → Перезагрузка      ${CG}║${C0}\n"
printf "${CG}║${C0}  Кнопка Reset: >= 3с → Сброс настроек   ${CG}║${C0}\n"
printf "${CG}╚══════════════════════════════════════════╝${C0}\n\n"

EOF

sh /tmp/install_titan_panel_v2.sh


exit 0
