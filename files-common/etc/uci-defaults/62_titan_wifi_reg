#!/bin/sh
# Регуляторный домен и каналы Wi-Fi.
#
# Без кода страны драйвер работает в домене «00» (world) и держит
# закрытым почти весь 5 ГГц: на стенде из 28 каналов доступны были 4 —
# 36, 40, 44 и 48. С кодом RU открывается 17, включая верхний блок
# 149-165, который не требует DFS и обычно свободнее нижнего.
#
# Файл отдельный от 60_atlanta_panel потому, что тот трогает Wi-Fi
# только на чистой прошивке (по маркеру /etc/titan_installed). Код
# страны нужен и на уже проданных роутерах, а uci-defaults из нового
# образа отрабатывают и после обновления.

WIFI_CHANGED=0

for _dev in $(uci -q show wireless 2>/dev/null | grep "=wifi-device" | cut -d. -f2 | cut -d= -f1); do
	# Код страны выставляем всегда, если его нет. Если клиент задал
	# свой — не трогаем.
	if [ -z "$(uci -q get wireless.$_dev.country 2>/dev/null)" ]; then
		uci -q set wireless.$_dev.country='RU'
		WIFI_CHANGED=1
	fi

	_band="$(uci -q get wireless.$_dev.band 2>/dev/null)"
	_chan="$(uci -q get wireless.$_dev.channel 2>/dev/null)"

	# Канал меняем ТОЛЬКО если он остался заводским. Одинаковый канал
	# на всём парке означает, что два наших роутера в соседних
	# квартирах гарантированно мешают друг другу.
	case "$_band:$_chan" in
	2g:1)
		# ACS выберет из 1/6/11 по эфиру.
		uci -q set wireless.$_dev.channel='auto'
		WIFI_CHANGED=1
		;;
	5g:36)
		# Не auto: ACS может выбрать DFS-канал, и тогда точка ждёт
		# минуту радарной проверки перед стартом, а при ложном
		# срабатывании ещё и прыгает на другой канал. 149 лежит вне
		# DFS, открывается кодом RU и обычно свободнее нижнего блока.
		uci -q set wireless.$_dev.channel='149'
		WIFI_CHANGED=1
		;;
	esac
done

if [ "$WIFI_CHANGED" = 1 ]; then
	uci -q commit wireless
	logger -t titan_wifi_reg "код страны RU, каналы переведены с заводских"
fi

exit 0
