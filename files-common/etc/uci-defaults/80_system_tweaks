#!/bin/sh

# ── IPv6 отключить ──────────────────────────────
# Интерфейсы wan6, ip6assign и раздача RA убраны из конфигов совсем.
# Здесь добиваем остатки. Секции wan6 у ZBT не было изначально, поэтому
# прежний uci set network.wan6.disabled на нём просто падал с ошибкой.
uci -q set network.wan.ipv6='0'
uci -q delete network.wan6
uci commit network
/etc/init.d/odhcpd disable 2>/dev/null
/etc/init.d/odhcpd stop 2>/dev/null

# ── Flow offloading ─────────────────────────────
# Выключено намеренно и включать нельзя — ломает PassWall.
#
# Ускорение уводит установленные соединения во flowtable, и дальнейшие
# пакеты идут мимо netfilter. А вся маршрутизация PassWall на этом
# netfilter и держится: UDP заворачивается через tproxy, пакетам
# ставится метка 0x50535731, и по ней правило `from all fwmark
# 0x50535731 lookup 999` уводит их в отдельную таблицу. Пакет, ушедший
# во flowtable, метку не получает — соединение либо утекает напрямую
# мимо туннеля, либо встаёт.
#
# Аппаратное хуже программного: на filogic NAT целиком уезжает в PPE и
# для netfilter становится невидимым.
#
# Тем же путём обходился бы и родительский контроль: правила
# guest_parental_* живут в цепочках fw4, и offload их пропустил бы.
#
# Плата за это — маршрутизация направо идёт процессором. На нагрузке
# смотреть titan_loadwatch.sh, а не возвращать offload.
uci set firewall.@defaults[0].flow_offloading='0'
uci set firewall.@defaults[0].flow_offloading_hw='0'
uci commit firewall

# ── zram ────────────────────────────────────────
MEM_KB=$(awk '/MemTotal/{print $2}' /proc/meminfo)
if [ "$MEM_KB" -gt 450000 ]; then
    ZRAM_MB=256
elif [ "$MEM_KB" -gt 200000 ]; then
    ZRAM_MB=128
else
    ZRAM_MB=64
fi
uci -q delete system.zram_swap 2>/dev/null
uci set system.zram_swap=zram
uci set system.zram_swap.enabled='1'
uci set system.zram_swap.zram_size_mb="$ZRAM_MB"
uci commit system

logger -t system_tweaks "Applied: IPv6 off, flow offload off, zram=${ZRAM_MB}MB"
exit 0
