#!/bin/sh
# Titan Router — кнопка Reset
#   < 3 сек   → перезагрузка
#   >= 3 сек  → заводской сброс: панель, PassWall на балансер,
#               сеть и Wi-Fi из образа, гостевая сеть снесена
[ "$BUTTON" = "reset" ] || exit 0
[ "$ACTION" = "released" ] || exit 0

if [ "${SEEN:-0}" -lt 3 ]; then
  logger -t titan "Перезагрузка по кнопке reset"
  sleep 1
  reboot
  exit 0
fi

logger -t titan "СБРОС до заводских: панель, PassWall, сеть, Wi-Fi"

# ── Панель: логин, пароль и мастер настройки заново ──────────────
# /rom — squashfs из образа, там лежит исходный конфиг. Если его вдруг
# нет (не squashfs-сборка), выставляем значения вручную.
if [ -f /rom/etc/config/atl_panel ]; then
  cp /rom/etc/config/atl_panel /etc/config/atl_panel
else
  uci -q set atl_panel.main.user='admin'
  uci -q set atl_panel.main.pass='admin'
  uci -q delete atl_panel.main.setup_done
  uci -q commit atl_panel
fi
rm -f /tmp/atl_panel_sid /tmp/atl_panel_update.lock 2>/dev/null

# ── Сеть: WAN и LAN из образа ────────────────────────────────────
# Восстанавливаем файл целиком, чтобы у каждой модели вернулось своё имя
# WAN-устройства: eth1 у ZBT, eth0 у TR3000, wan у WR3000S и WR3000E.
[ -f /rom/etc/config/network ] && cp /rom/etc/config/network /etc/config/network

# ── PassWall: вернуть узел на балансер ───────────────────────────
NODE=$(uci -q show passwall 2>/dev/null \
  | sed -n "s/^passwall\.\([^.]*\)\.remarks='TitanSwitch'\$/\1/p" | head -1)
[ -n "$NODE" ] || NODE='fNDZDacw'
# PassWall 26.8.26 читает node; tcp_node и udp_node пишем для более
# ранних сборок, его же миграция уберёт лишнее на следующей загрузке.
uci -q set passwall.@global[0].node="$NODE"
uci -q set passwall.@global[0].tcp_node="$NODE"
uci -q set passwall.@global[0].udp_node="$NODE"
uci -q set passwall.@global[0].enabled='1'
uci -q commit passwall

# ── Гостевая сеть и родительский контроль ────────────────────────
uci -q delete wireless.guest_radio0
uci -q delete wireless.guest_radio1
uci -q delete network.guest
uci -q delete dhcp.guest
rm -f /etc/dnsmasq.d/guest-parental.conf /etc/dnsmasq.d/atl_parental.conf 2>/dev/null
rm -f /etc/crontabs/atl_parental /etc/hotplug.d/iface/30-guest-bypass 2>/dev/null

# ── Wi-Fi: открытые сети, как после первой прошивки ──────────────
uci -q set wireless.default_radio0.ssid='Titan-2.4'
uci -q set wireless.default_radio0.encryption='none'
uci -q delete wireless.default_radio0.key
uci -q set wireless.default_radio0.disabled='0'
if uci -q get wireless.radio1.type >/dev/null 2>&1; then
  uci -q set wireless.default_radio1.ssid='Titan-5'
  uci -q set wireless.default_radio1.encryption='none'
  uci -q delete wireless.default_radio1.key
  uci -q set wireless.default_radio1.disabled='0'
fi

uci -q commit wireless
uci -q commit network
uci -q commit dhcp

logger -t titan "Сброс завершён, перезагрузка"
sleep 1
reboot
