CUR_5_KEY="$(uci -q get wireless.default_radio1.key 2>/dev/null || echo "")"

CUR_USER_CFG="$(getcfg user)"; CUR_PASS_CFG="$(getcfg pass)"
SETUP_DONE="$(getcfg setup_done)"; [ -z "${SETUP_DONE:-}" ] && SETUP_DONE="0"

DEFAULT_WARN="0"
[ "$CUR_USER_CFG" = "admin" ] && [ "$CUR_PASS_CFG" = "admin" ] && DEFAULT_WARN="1"

# Подписка не оплачена: провайдер отдаёт в подписке ноду Router_Telegram
SUB_UNPAID="0"
if uci -q show passwall 2>/dev/null | grep -qi "\.remarks=.*Router_Telegram"; then
