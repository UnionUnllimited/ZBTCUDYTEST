[data-theme="dark"] .msg{color:#80ffbb;background:rgba(39,201,122,.07);border-color:rgba(39,201,122,.2)}
</style>
</head>
<body>
<button class="theme-toggle" id="themeBtn" onclick="toggleTheme()">Тёмная</button>
<div class="login-wrap">
  <div class="logo-area">
    <div class="logo">Titan Router</div>
    <div class="logo-sub">Панель управления роутером</div>
    ${ES_LOGIN_MODEL:+<div class="logo-model"><span class="logo-model-dot"></span>${ES_LOGIN_MODEL}</div>}
  </div>
