# ─── API: статус сети ──────────────────────────────────────────
if [ "${GET_ACT:-}" = "api_status" ]; then
  echo "Content-type: application/json; charset=utf-8"
  echo "Cache-Control: no-store, no-cache"
  echo ""
  run_ping_checks
  exit 0
fi

# ─── API: список устройств ─────────────────────────────────────
if [ "${GET_ACT:-}" = "api_devices" ]; then
  echo "Content-type: application/json; charset=utf-8"
  echo "Cache-Control: no-store, no-cache"
  echo ""
  # Читаем DHCP leases: ts MAC IP hostname
  TMP_DEV="/tmp/atl_dev.$$"
  printf '{"devices":['  > "$TMP_DEV"
  FIRST=1
  if [ -f /tmp/dhcp.leases ]; then
    while IFS=' ' read -r ts mac ip name _rest; do
      [ -n "$ip" ] || continue
      [ "$mac" = "*" ] && continue
      # Проверяем активность через ARP
      ACTIVE="false"
      grep -qi "$ip " /proc/net/arp 2>/dev/null && ACTIVE="true"
      [ "$FIRST" = "1" ] && FIRST=0 || printf ',' >> "$TMP_DEV"
      name="${name:-Unknown}"
      printf '{"ip":"%s","mac":"%s","name":"%s","active":%s}'         "$ip" "$mac" "$name" "$ACTIVE" >> "$TMP_DEV"
    done < /tmp/dhcp.leases
  fi
  # Добавляем из ARP то, чего нет в leases
  if [ -f /proc/net/arp ]; then
    awk 'NR>1 && $4!="00:00:00:00:00:00" && $3=="0x2" {print $1,$4}' /proc/net/arp |     while IFS=' ' read -r ip mac; do
      grep -q "$mac" /tmp/dhcp.leases 2>/dev/null && continue
      [ "$FIRST" = "1" ] && FIRST=0 || printf ',' >> "$TMP_DEV"
      printf '{"ip":"%s","mac":"%s","name":"Unknown","active":true}' "$ip" "$mac" >> "$TMP_DEV"
    done
  fi
  printf ']}' >> "$TMP_DEV"
  cat "$TMP_DEV"
  rm -f "$TMP_DEV"
  exit 0
fi

# ─── API: статистика трафика ────────────────────────────────────
if [ "${GET_ACT:-}" = "api_stats" ]; then
  echo "Content-type: application/json; charset=utf-8"
  echo "Cache-Control: no-store, no-cache"
  echo ""
  # WAN интерфейс — ищем активный
  WIF="$(detect_wan_iface)"
  for _if in ppp0 pppoe-wan "$WIF" eth0 eth1; do
    [ -f "/sys/class/net/$_if/statistics/rx_bytes" ] && { WIF="$_if"; break; }
  done
  RX=0; TX=0
  [ -f "/sys/class/net/$WIF/statistics/rx_bytes" ] && RX="$(cat /sys/class/net/$WIF/statistics/rx_bytes 2>/dev/null || echo 0)"
  [ -f "/sys/class/net/$WIF/statistics/tx_bytes" ] && TX="$(cat /sys/class/net/$WIF/statistics/tx_bytes 2>/dev/null || echo 0)"
  # Активные соединения
  CONNS=0
  if [ -f /proc/net/nf_conntrack ]; then
    CONNS="$(wc -l < /proc/net/nf_conntrack 2>/dev/null || echo 0)"
  elif command -v conntrack >/dev/null 2>&1; then
    CONNS="$(conntrack -L 2>/dev/null | wc -l || echo 0)"
  fi
  printf '{"iface":"%s","rx_bytes":%s,"tx_bytes":%s,"connections":%s}'     "$WIF" "$RX" "$TX" "$CONNS"
  exit 0
fi

# ─── API: состояние обновления прошивки ─────────────────────────
# Панель опрашивает его, пока идёт проверка или закачка: сам скрипт
# работает в фоне и о ходе дела рассказывает только своим выводом.
if [ "${GET_ACT:-}" = "api_ota" ]; then
  echo "Content-type: application/json; charset=utf-8"
  echo "Cache-Control: no-store, no-cache"
  echo ""
  _ob="$(ota_build)"; [ -n "$_ob" ] || _ob=null
  _ost="$(awk '{print $1}' "$OTA_STATUS" 2>/dev/null || true)"
  _oat="$(awk '{print $2}' "$OTA_STATUS" 2>/dev/null | tr -dc '0-9' || true)"
  [ -n "${_oat:-}" ] || _oat=null
  if ota_busy;  then _orun=true; else _orun=false; fi
  if ota_ready; then _ordy=true; else _ordy=false; fi
  printf '{"build":%s,"status":"%s","at":%s,"running":%s,"ready":%s,"log":"'     "$_ob" "${_ost:-}" "$_oat" "$_orun" "$_ordy"
  tail -n 60 "$OTA_RUN_LOG" 2>/dev/null | json_escape
  printf '"}'
  exit 0
fi


# ─── API: URL Test серверов ────────────────────────────────────
# Зовём штатный PassWall, а не меряем сами.
#
# Своя проверка стучалась curl'ом прямо в порт узла и считала живым
# только то, что ответило по HTTP. Но на этих портах VLESS и Reality,
# отвечать по HTTP они не обязаны — и все узлы поголовно показывались
# как «✗», хотя туннель через них работал. В списке узлов самого
# PassWall при этом видно обратное: TCPing может стоять Timeout, а
# URL Test — 1219 ms, потому что он меряет иначе.
#
# test.sh url_test_node поднимает временный SOCKS через саму ноду и
# гонит сквозь неё настоящий запрос, возвращая «код:время». Это и есть
# честная проверка, и повторять её своими силами незачем.
#
# Цена — время: на каждый узел временный xray, пауза 2с и запрос до 5с.
# Поэтому строго последовательно (пять xray разом эту железку положат)
# и с дедлайном: uhttpd убивает CGI через 60 секунд.
if [ "${GET_ACT:-}" = "api_ping_nodes" ]; then
  echo "Content-type: application/json; charset=utf-8"
  echo "Cache-Control: no-store, no-cache"
  echo ""
  PW_TEST="/usr/share/passwall/test.sh"
  _pdir="/tmp/atl_ping_$$"
  if ! mkdir -p "$_pdir" 2>/dev/null; then printf '{}'; exit 0; fi

  # Подчищаем xray от прерванного прошлого прогона: если CGI убили по
  # таймауту, его временные процессы остаются висеть и едят память.
  for _stale in $(pgrep -f 'url_test_.*\.json' 2>/dev/null || true); do
    kill -9 "$_stale" 2>/dev/null || true
  done
  # Собираем ноды через pw_nodes_list (те же секции что в select).
  # Балансер отсеивается сам: у него нет address, а тестировать группу
  # нечем — url_test_node работает с конкретным узлом.
  pw_nodes_list 2>/dev/null > "$_pdir/seclist.txt" || true
  _n=0
  while IFS="$(printf '\t')" read -r _sec _rem; do
    [ -n "$_sec" ] || continue
    _addr="$(uci -q get passwall."$_sec".address 2>/dev/null || true)"
    [ -n "$_addr" ] || continue
    _n=$((_n+1))
    printf '%s\t%s\n' "$_n" "$_sec"
  done < "$_pdir/seclist.txt" > "$_pdir/nodes.txt" 2>/dev/null || true
  # Последовательно и с дедлайном. Узлы, до которых не успели, отдаём
  # как -3 — панель покажет их без метки, а не соврёт про «мёртв».
  _deadline=$(( $(date +%s) + 30 ))
  while IFS="$(printf '\t')" read -r _num _sec; do
    [ -n "$_num" ] && [ -n "$_sec" ] || continue
    _nf="$_pdir/r_$_num"
    _sf="$_pdir/s_$_num"
    printf '%s' "$_sec" > "$_sf"
    (
      _ms="-3"
      if [ -x "$PW_TEST" ] && [ "$(date +%s)" -lt "$_deadline" ]; then
        # Отдаёт «код:время», например 204:0.214000
        _raw="$(sh "$PW_TEST" url_test_node "$_sec" 2>/dev/null | tail -n1)"
        _code="${_raw%%:*}"
        _time="${_raw#*:}"
        case "$_code" in
          200|204|301|302)
            _ms="$(awk "BEGIN{v=${_time:-0}*1000; printf \"%d\", (v<1)?1:v}" 2>/dev/null || echo "-1")"
            ;;
          *) _ms="-1" ;;
        esac
      fi
      printf '%s' "$_ms" > "$_nf"
    )
  done < "$_pdir/nodes.txt"

  # Собираем JSON по номерам — без glob по спецсимволам
  _json='{'
  _sep=''
  _i=1
  while [ -f "$_pdir/s_$_i" ]; do
    _s="$(cat "$_pdir/s_$_i" 2>/dev/null || true)"
    _m="$(cat "$_pdir/r_$_i" 2>/dev/null || true)"
    [ -n "$_s" ] && _json="${_json}${_sep}\"${_s}\":${_m:--1}" && _sep=','
    _i=$((_i+1))
  done
  _json="${_json}}"
  printf '%s' "$_json"
  rm -rf "$_pdir"
  exit 0
fi



