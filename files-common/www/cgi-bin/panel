// Скрипт запускается в фоне и лок ставит не мгновенно. Если бы опрос
// прекращался по первому же running:false, панель успевала бы решить,
// что всё кончилось, ещё до того как проверка началась. Поэтому после
// нажатия кнопки опрашиваем несколько раз подряд в любом случае.
var _otaTimer = null, _otaFails = 0, _otaWasRunning = false;
var _otaMinPolls = 1, _otaPolls = 0;

function otaPoll(){
  if(_otaTimer){ clearTimeout(_otaTimer); _otaTimer = null; }
  fetch('/cgi-bin/panel?action=api_ota', {credentials:'include', cache:'no-store'})
    .then(function(r){ return r.json(); })
    .then(function(d){
      _otaFails = 0;
      var b = g('ota-build');
      if(b && d.build !== null && d.build !== undefined) b.textContent = d.build;
      otaSetStatus(d.status, d.at);
      var lg = g('ota-log');
      if(lg && d.log){
        lg.style.display = 'block';
        lg.textContent = d.log;
        lg.scrollTop = lg.scrollHeight;
      }
      _otaPolls++;
      otaBusy(d.running);
      if(d.running) _otaWasRunning = true;
      if(d.running || _otaPolls < _otaMinPolls){
        _otaTimer = setTimeout(otaPoll, 3000);
      }
    })
    .catch(function(){
      _otaFails++;
      // Ответы кончились уже после старта установки: sysupgrade закрывает
      // все сессии и начинает перезапись флеша.
      if(_otaWasRunning && _otaFails >= 2){ otaRebooting(); return; }
      if(_otaFails < 10) _otaTimer = setTimeout(otaPoll, 3000);
    });
}

function otaRebooting(){
  otaBusy(true);
  var h = g('ota-hint');
  if(h) h.textContent = '⏳ Роутер прошивается и перезагружается. Не выключайте питание — страница обновится сама.';
  (function again(){
    fetch(location.href.split('/cgi-bin')[0] + '/', {mode:'no-cors', cache:'no-store'})
      .then(function(){ location.href = '/'; })
      .catch(function(){ setTimeout(again, 3000); });
  })();
}

