OTA_BUILD="$(ota_build)"
[ -n "$OTA_BUILD" ] || OTA_BUILD="неизвестна"
OTA_CODE="$(awk '{print $1}' "$OTA_STATUS" 2>/dev/null || true)"
OTA_AT="$(awk '{print $2}' "$OTA_STATUS" 2>/dev/null | tr -dc '0-9' || true)"
if ota_ready; then
  OTA_DIS=""
  OTA_HINT="ℹ️ Роутер проверяет обновления сам каждую ночь и ставит их по очереди, партиями. Эти кнопки делают то же самое сразу, без ожидания очереди."
else
  OTA_DIS="disabled"
  OTA_HINT="⚠️ Адрес обновления не задан, кнопки не сработают. Обратитесь в поддержку."
fi

GUEST_STATE="$(guest_state)"
case "$GUEST_STATE" in
  on)
    GUEST_LABEL="Включена"
    GUEST_BTN="Отключить"
    GUEST_DOT="ok"
    GUEST_SSID="$(uci -q get wireless.guest_radio0.ssid 2>/dev/null || echo "Titan-Guest")"
    GUEST_KEY="$(uci -q get wireless.guest_radio0.key 2>/dev/null || echo "")"
    ;;
  *)
    GUEST_LABEL="Выключена"
    GUEST_BTN="Включить"
    GUEST_DOT="bad"
    GUEST_SSID="Titan-Guest"
    GUEST_KEY=""
    ;;
esac
ES_GUEST_SSID="$(he "$GUEST_SSID")"
ES_GUEST_KEY="$(he "$GUEST_KEY")"

# Родительский контроль — текущее состояние
PAR_STATES="$(parental_state)"
PAR_DNS="$(printf '%s' "$PAR_STATES" | awk '{print $1}')"
PAR_SCHED="$(printf '%s' "$PAR_STATES" | awk '{print $2}')"
PAR_BLOCK="$(printf '%s' "$PAR_STATES" | awk '{print $3}')"
PAR_DNS_CHK=""; [ "$PAR_DNS" = "1" ] && PAR_DNS_CHK="checked"
PAR_SCHED_CHK=""; [ "$PAR_SCHED" = "1" ] && PAR_SCHED_CHK="checked"
PAR_DOMAINS="$(grep '^address=/' "${PARENTAL_CONF}" 2>/dev/null | sed "s|^address=/||;s|/#$||" | tr '
' ',' | sed 's/,$//' || true)"
PAR_SCHED_OFF="$(grep 'atl_parental' "${PARENTAL_CRON}" 2>/dev/null | head -1 | awk '{print $2":"$1}' || echo "22:00")"
PAR_SCHED_ON="$(grep 'atl_parental' "${PARENTAL_CRON}" 2>/dev/null | tail -1 | awk '{print $2":"$1}' || echo "07:00")"
[ -n "$PAR_SCHED_OFF" ] || PAR_SCHED_OFF="22:00"
[ -n "$PAR_SCHED_ON"  ] || PAR_SCHED_ON="07:00"
ES_PAR_DOMAINS="$(he "$PAR_DOMAINS")"
ES_PAR_OFF="$(he "$PAR_SCHED_OFF")"
ES_PAR_ON="$(he "$PAR_SCHED_ON")"

PW_CURRENT="$(pw_current_node)"; [ -n "${PW_CURRENT:-}" ] || PW_CURRENT=""
PW_CURRENT_LABEL="$(pw_node_label "$PW_CURRENT")"

PW_OPTIONS=""
if pw_exists; then
  PW_TMP="$(pw_nodes_list || true)"
  if [ -n "${PW_TMP:-}" ]; then
    echo "$PW_TMP" | while IFS="$(printf '\t')" read -r sec rem; do
      [ -n "${sec:-}" ] || continue; [ -n "${rem:-}" ] || rem="$sec"
      label="$rem"
      case "$label" in TitanSwitch|TITANSWITCH|titanswitch) label="Авто (балансер)" ;; esac
      case "$sec" in *TitanSwitch*|*TITANSWITCH*|*titanswitch*) label="Авто (балансер)" ;; esac
      label="$(normalize_server_label "$label")"
      ES_SEC="$(he "$sec")"; ES_REM="$(he "$label")"
      if [ "$PW_CURRENT" = "$sec" ]; then
        printf '<option value="%s" selected>%s</option>\n' "$ES_SEC" "$ES_REM"
      else
        printf '<option value="%s">%s</option>\n' "$ES_SEC" "$ES_REM"
      fi
    done > /tmp/atl_pw_opts.$$ 2>/dev/null || true
    PW_OPTIONS="$(cat /tmp/atl_pw_opts.$$ 2>/dev/null || true)"
    rm -f /tmp/atl_pw_opts.$$ 2>/dev/null || true
  fi
fi

# tcp_node вполне может указывать на секцию, которой в списке нет:
# балансировщик без remarks, узел, исчезнувший после обновления подписки.
# Тогда ни один option не помечен selected — и браузер показывает первый
# по алфавиту. Клиент видит сервер, через который он не работает, а нажав
# «Применить», ещё и переключается на него с балансировщика.
# Поэтому текущий узел дописываем явно и помечаем сами.
case "$PW_OPTIONS" in
  *" selected>"*) ;;
  *)
    if [ -n "${PW_CURRENT:-}" ]; then
      _es_cur="$(he "$PW_CURRENT")"
      _es_lab="$(he "${PW_CURRENT_LABEL:-$PW_CURRENT}")"
      PW_OPTIONS="$(printf '<option value="%s" selected>%s</option>\n%s' \
        "$_es_cur" "$_es_lab" "$PW_OPTIONS")"
    fi
    ;;
esac

# В шапке — то же название, что видит клиент в боте. Имя хоста
# сюда не подставляем: «OpenWrt» под маркой выглядит опечаткой.
ES_NAME="$(he "$(model_title)")"
ES_MSG="$(he "${MSG:-}")"
ES_ERR="$(he "${ERR:-}")"
ES_WAN="$(he "$CUR_WAN")"
ES_WANIF="$(he "$WAN_IFACE")"
ES_MAC="$(he "$MAC")"
ES_USER="$(he "$CUR_USER")"
ES_PASS="$(he "$CUR_PASS")"
ES_SERVER="$(he "$CUR_SERVER")"
ES_IP="$(he "$CUR_IP")"
ES_MASK="$(he "$CUR_MASK")"
ES_GW="$(he "$CUR_GW")"
ES_DNS1="$(he "$CUR_DNS1")"
ES_DNS2="$(he "$CUR_DNS2")"
ES_24_SSID="$(he "$CUR_24_SSID")"
ES_24_KEY="$(he "$CUR_24_KEY")"
ES_5_SSID="$(he "$CUR_5_SSID")"
ES_5_KEY="$(he "$CUR_5_KEY")"
ES_PU="$(he "$CUR_USER_CFG")"
ES_PP="$(he "$CUR_PASS_CFG")"
ES_INSTALLED_VER="$(he "$INSTALLED_VER")"
ES_OTA_BUILD="$(he "$OTA_BUILD")"
ES_OTA_CODE="$(he "${OTA_CODE:-}")"
ES_OTA_AT="$(he "${OTA_AT:-0}")"
ES_OTA_HINT="$(he "$OTA_HINT")"
ES_PW_CURRENT_LABEL="$(he "$PW_CURRENT_LABEL")"
ES_SYS_WAN_IP="$(he "$SYS_WAN_IP_SHOW")"
ES_SYS_WAN_GW="$(he "$SYS_WAN_GW_SHOW")"
ES_SYS_DNS="$(he "$SYS_DNS")"
ES_SYS_WAN_L3="$(he "$SYS_WAN_L3")"

echo "Content-type: text/html; charset=utf-8"
echo ""
cat <<HTML
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Titan Router</title>
<link rel="icon" type="image/png" href="/logo.png">
<style>
/* ══ Оформление ══════════════════════════════════════════════
   Взято из мини-аппа Titan (api/static/miniapp/app.css): те же
   поверхности, тот же акцент, тот же шрифт. Панель роутера и
   приложение в Telegram клиент видит в один вечер, и выглядеть
   они должны одним продуктом, а не двумя подрядами.

   Три правила оттуда, от которых здесь всё остальное.

   Глубина делается тоном, а не рамкой. Уровни поверхности
   отличаются светлотой на пару процентов, а край карточке даёт
   волосяная обводка изнутри. Прежняя панель обводила каждую
   карточку линией в 7% белого — на тёмном это читается сеткой,
   а не слоями.

   Акцент один и плоский. Градиент остаётся у главной кнопки,
   всё остальное красится тем же синим заливкой в 14%. Раньше
   градиент был на кнопках, шапке, метках и бургере сразу, и
   экран выглядел нарядным.

   Строки живут группами. Разделитель отступлен до текста, а не
   идёт от края: так список читается одним блоком.
   ═══════════════════════════════════════════════════════════ */

/* Rubik: геометричный, со слегка скруглёнными углами, с полной
   кириллицей. Системным шрифтом панель выглядит как любая тёмная
   админка, собранная по умолчанию. Файл один на все толщины —
   шрифт переменный, ось 300-900.
   Лежит в образе, а не на чужом адресе: панель открывают с
   роутера, у которого интернета может не быть вовсе. */
@font-face{
  font-family:'Rubik';font-style:normal;font-weight:300 900;font-display:swap;
  src:url('/fonts/rubik-cyrillic.woff2') format('woff2');
  unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;
}
@font-face{
  font-family:'Rubik';font-style:normal;font-weight:300 900;font-display:swap;
  src:url('/fonts/rubik-latin.woff2') format('woff2');
  unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,
    U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,
    U+2212,U+2215,U+FEFF,U+FFFD;
}

/* ══ Переменные ═══════════════════════════════════════════════ */
:root{
  /* Уровни поверхности, от дальнего к ближнему. */
  --bg:#0a0f18;
  --s1:#121a28;--s2:#172131;--s3:#1e2a3d;
  --b1:rgba(255,255,255,.08);--b2:rgba(255,255,255,.16);
  --txt:#f0f4fa;--mut:#9aabc4;--dim:#6b7d96;
  --acc:#3b93ff;--acc2:#22d3ee;--acc3:#2f7fe0;
  --acc-dim:rgba(59,147,255,.14);
  --grad:linear-gradient(135deg,#3b93ff,#22d3ee);
  --ok:#34d399;--ok-dim:rgba(52,211,153,.13);
  --warn:#fbbf24;--warn-dim:rgba(251,191,36,.13);
  --bad:#fb7185;--bad-dim:rgba(251,113,133,.13);
  /* Радиусы крупнее прежних: 16/10/6 против 18/13/10. Мелкий
     радиус на крупной карточке читается срезанным углом. */
  --r:18px;--rs:13px;--rx:10px;
  --pad:16px;
  /* Волосяная обводка изнутри. На OLED карточка на почти чёрном
     без неё теряет край, а тон уровней слишком близок, чтобы
     держать его одному. */
  --edge:inset 0 0 0 1px rgba(255,255,255,.035);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0}
html{height:100%;-webkit-text-size-adjust:100%}
body{
  min-height:100vh;color:var(--txt);background:var(--bg);overflow-x:hidden;
  font:15px/1.5 'Rubik',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  -webkit-font-smoothing:antialiased;
  /* Цифры одной ширины: в столбце адресов и скоростей прыгающая
     разрядка заметна сразу. */
  font-variant-numeric:tabular-nums;
}
/* Подсветка вверху очень слабая: свет объясняет, где верх, и не
   более того. Прежний фон был просто чёрным, и страница не имела
   ни верха, ни низа. */
body::before{
  content:'';position:fixed;inset:0 0 auto 0;height:240px;pointer-events:none;z-index:0;
  background:radial-gradient(100% 100% at 50% 0%,rgba(59,147,255,.1),transparent 68%);
}
a{color:inherit;text-decoration:none}
::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:99px}
.wrap{position:relative;z-index:1;width:min(1640px,calc(100vw - 32px));margin:0 auto;padding:10px 0 48px}
.panel-footer{color:var(--dim);font-size:12px;font-weight:600;text-align:center;padding-top:22px}

/* ══ Шапка ════════════════════════════════════════════════════ */
/* Шапка — такая же скруглённая карточка, как блоки под ней, а не
   прямоугольная полоса во всю ширину. Прямоугольник с прижатыми к
   краям знаком и бургером выглядел не частью страницы, а чужой
   панелью, приклеенной сверху.
   Прилипает с отступом сверху, поэтому под ней видно фон, и
   скругление читается со всех четырёх сторон. */
.header{
  display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;
  margin-bottom:12px;position:sticky;top:10px;z-index:150;padding:9px 14px;
  border-radius:var(--r);
  background:rgba(18,26,40,.82);box-shadow:var(--edge);
  -webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);
}
.header .meta-chips{justify-self:center}
.header #burgerBtn{justify-self:end}
.header .brand{justify-self:start}
.brand{display:flex;align-items:center;gap:10px}
/* Знак стоит сам по себе, без подложки: у него свой градиент, и
   синий квадрат под ним спорил с ним же. */
.brand-icon{width:34px;height:34px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.brand-icon img{display:block;width:34px;height:34px}
.brand h1{font-size:15px;font-weight:650;letter-spacing:-.25px;color:var(--txt)}
.brand-sub{font-size:11px;color:var(--dim);margin-top:1px}
.meta-chips{display:flex;gap:6px;flex-wrap:wrap;align-items:center;justify-content:center}
/* Чип тональный, без рамки: рамка делала его похожим на поле ввода. */
.mchip{
  display:flex;align-items:center;gap:6px;background:var(--s1);border:0;
  border-radius:999px;padding:6px 11px;font-size:12px;font-weight:600;color:var(--mut);
  box-shadow:var(--edge);
}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--ok);flex-shrink:0;animation:lpulse 2.6s ease-in-out infinite}
@keyframes lpulse{50%{opacity:.3}}

/* ══ Полоса состояния ═════════════════════════════════════════ */
.status-bar{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 12px;justify-content:center}
.si{
  display:flex;align-items:stretch;background:var(--s1);border:0;border-radius:999px;
  overflow:hidden;box-shadow:var(--edge);transition:background .12s;
}
.si:hover{background:var(--s2)}
.si-left{display:flex;align-items:center;gap:7px;padding:6px 12px}
.si-right{display:none} /* текст скрыт — статус через цвет точки */
.sdot{width:7px;height:7px;border-radius:50%;flex-shrink:0;background:rgba(255,255,255,.18);transition:background .4s}
.sdot.ok{background:var(--ok);animation:lpulse 2.6s ease-in-out infinite}
.sdot.bad{background:var(--bad)}
.sdot.loading{animation:blink 1s infinite}
@keyframes blink{0%,100%{opacity:.15}50%{opacity:1}}
.sname{font-size:12px;color:var(--mut);font-weight:600;white-space:nowrap}
.sval{font-size:11px;font-weight:700;white-space:nowrap}

/* ══ Боковое меню ═════════════════════════════════════════════ */
#navOverlay{display:none;position:fixed;inset:0;z-index:298;background:rgba(4,8,14,.6);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
#navOverlay.on{display:block}
/* Выезжает справа: бургер стоит справа, и панель, вылетающая с
   противоположной стороны, читается как чужая — палец идёт к
   кнопке, а меню открывается у другого края. */
.nav{
  display:flex;flex-direction:column;flex-wrap:nowrap;
  position:fixed;right:0;top:0;bottom:0;width:280px;z-index:299;
  background:var(--s1);border-left:0;box-shadow:-8px 0 48px rgba(0,0,0,.6),var(--edge);
  transform:translateX(100%);transition:transform .26s cubic-bezier(.4,0,.2,1);
  overflow-y:auto;overflow-x:hidden;
}
.nav.is-open{transform:translateX(0)}
.nav-header{display:flex;align-items:center;justify-content:space-between;padding:18px 16px 14px;border-bottom:1px solid var(--line,rgba(255,255,255,.08));flex-shrink:0}
/* Название в шапке меню — обычным цветом. Градиентный текст здесь
   спорил с градиентом на главной кнопке, и оба переставали быть
   главными. */
.nav-header-title{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:700;letter-spacing:-.3px;color:var(--txt);white-space:nowrap}
.nav-header-title img{display:block;flex:0 0 22px}
.nav-close{
  width:32px;height:32px;border-radius:10px;background:var(--s3);border:0;
  color:var(--mut);font-size:16px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  touch-action:manipulation;flex-shrink:0;transition:background .12s,color .12s;
}
.nav-close:hover{background:var(--b1);color:var(--txt)}
.nav-items{display:flex;flex-direction:column;padding:8px 10px;gap:2px;flex:1}
.nav a,.nav button{
  display:inline-flex;align-items:center;width:100%;min-height:46px;
  font:inherit;font-size:14px;font-weight:600;border-radius:var(--rs);
  justify-content:flex-start;padding:11px 14px;background:transparent;border:0;
  color:var(--txt);gap:11px;cursor:pointer;white-space:nowrap;
  transition:background .12s,color .12s;
  -webkit-user-select:none;user-select:none;touch-action:manipulation;
  text-align:left;
}
.nav a .grow,.nav button .grow{text-align:left}
.nav a:hover,.nav button:hover{background:rgba(255,255,255,.05)}
.nav a:active,.nav button:active{background:rgba(255,255,255,.08)}
.nav a.primary,.nav button.primary{
  background:var(--grad);color:#04121f;font-weight:650;
  box-shadow:0 8px 22px -14px rgba(59,147,255,.9);
}
.nav a.primary:hover,.nav button.primary:hover{opacity:.92}
.nav-sep{height:1px;background:rgba(255,255,255,.08);margin:8px 4px}
/* Тональная строка меню: тот же акцент, но заливкой. */
.nav a.accent,.nav button.accent{background:var(--acc-dim);color:var(--acc)}
.nav a.accent .ic,.nav button.accent .ic{color:var(--acc)}
.nav a.accent:hover,.nav button.accent:hover{background:rgba(59,147,255,.22)}
/* Заголовок группы — как в настройках телефона: мелкий,
   приглушённый, капителью с разрядкой. */
.nav-section-label{font-size:11.5px;font-weight:600;color:var(--dim);text-transform:uppercase;letter-spacing:.07em;padding:10px 14px 4px}
.nav-home-btn{background:var(--acc-dim) !important;border:0 !important;font-weight:650 !important;color:var(--acc) !important;border-radius:var(--rs) !important}
.nav-home-btn:hover{background:rgba(59,147,255,.22) !important}
.nav-theme-btn{color:var(--dim) !important;font-size:13px !important;font-weight:600 !important}

/* ══ Сообщения ════════════════════════════════════════════════ */
/* Тональные, без рамки: цвет несёт смысл сам, обводка добавляла
   вес сообщению, которое чаще всего просто подтверждает действие. */
.msg,.okline{margin:10px 0;padding:11px 14px;border-radius:var(--rs);font-size:13px;font-weight:600;border:0;background:var(--ok-dim);color:var(--ok)}
.err,.badline{margin:10px 0;padding:11px 14px;border-radius:var(--rs);font-size:13px;font-weight:600;border:0;background:var(--bad-dim);color:var(--bad)}

/* ══ Сетка ════════════════════════════════════════════════════ */
.main-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px;align-items:stretch}
.main-grid > .win-col{display:flex;flex-direction:column;gap:12px}
.main-grid > .win-col > .card:last-child{flex:1}
.bot-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start}

/* ══ Карточки ═════════════════════════════════════════════════ */
.card{background:var(--s1);border:0;border-radius:var(--r);padding:var(--pad);position:relative;box-shadow:var(--edge)}
.card:hover{background:var(--s1)}
.card::before{content:none} /* блик по верхнему краю убран: край держит обводка */
.card-title{
  font-size:17px;font-weight:650;color:var(--txt);margin:0 0 12px;letter-spacing:-.25px;
  display:flex;align-items:center;gap:8px;justify-content:flex-start;text-align:left;
}
.card p{text-align:left}
.info-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 0;position:relative;font-size:14px}
/* Разделитель отступлен до текста: так группа читается одним
   блоком, а не списком без начала и конца. */
.info-row + .info-row::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:rgba(255,255,255,.08)}
.info-row:last-child{padding-bottom:0}
.info-row:first-child{padding-top:0}
.ir-label{color:var(--mut);font-weight:400;white-space:nowrap;font-size:14px}
.ir-value{font-weight:600;text-align:right;word-break:break-all;font-size:14px}

/* ══ Метки ════════════════════════════════════════════════════ */
.badge{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600;border:0;white-space:nowrap}
.badge-ok{background:var(--ok-dim);color:var(--ok)}
.badge-bad{background:var(--bad-dim);color:var(--bad)}
.badge-blue{background:var(--acc-dim);color:var(--acc)}
.badge-warn{background:var(--warn-dim);color:var(--warn)}
.info-hint{display:flex;align-items:flex-start;gap:9px;padding:11px 13px;border-radius:var(--rs);background:var(--s2);border:0;color:var(--mut);font-size:13px;line-height:1.5;margin:0 0 12px}
.info-hint.warn{background:var(--warn-dim);color:var(--warn)}
.info-hint:empty{display:none}
.warn-box{display:none;margin-top:10px;padding:11px 13px;border-radius:var(--rs);border:0;background:var(--warn-dim);color:var(--warn);font-size:13px;line-height:1.5}

/* ══ Поля ═════════════════════════════════════════════════════ */
/* Подпись обычной строчной, а не капителью в 10px: капитель тут
   стояла на каждом поле подряд и кричала, вместо того чтобы
   называть. */
label{display:block;color:var(--mut);font-size:13px;font-weight:400;margin:12px 0 7px;text-transform:none;letter-spacing:0;text-align:left}
input,select{
  width:100%;background:var(--s2);border:1px solid transparent;color:var(--txt);
  padding:13px 14px;border-radius:var(--rs);outline:none;min-height:46px;
  /* 16px не для красоты: на меньшем размере iOS увеличивает масштаб
     страницы при попадании в поле, и клиент теряет вёрстку прямо
     в момент ввода пароля. */
  font-size:16px;font-weight:400;font-family:inherit;
  transition:border-color .15s,background .15s;
}
select{
  appearance:none;-webkit-appearance:none;
  background-image:linear-gradient(45deg,transparent 50%,rgba(240,244,250,.55) 50%),linear-gradient(135deg,rgba(240,244,250,.55) 50%,transparent 50%);
  background-position:calc(100% - 16px) calc(50% - 2px),calc(100% - 12px) calc(50% - 2px);
  background-size:5px 5px,5px 5px;background-repeat:no-repeat;padding-right:38px;font-weight:500;cursor:pointer;
}
input:focus,select:focus{border-color:var(--acc);background:var(--s3);box-shadow:none}
option{background:#172131;color:var(--txt);font-weight:500}
input::placeholder{color:var(--dim)}
.pw-wrap{position:relative;display:flex;align-items:center}
.pw-wrap input{padding-right:42px;width:100%}
.pw-eye{
  position:absolute;right:12px;top:50%;transform:translateY(-50%);
  background:none;border:none;color:var(--dim);cursor:pointer;
  padding:4px;font-size:16px;line-height:1;
  touch-action:manipulation;-webkit-user-select:none;user-select:none;transition:color .15s;
}
.pw-eye:hover{color:var(--txt)}

/* ══ Кнопки ═══════════════════════════════════════════════════ */
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;justify-content:flex-start}
.btn{
  appearance:none;border:0;border-radius:var(--rs);padding:11px 16px;
  font-family:inherit;font-size:14.5px;font-weight:650;line-height:1;cursor:pointer;min-height:42px;
  transition:transform .1s ease,opacity .12s ease,background .12s;
  touch-action:manipulation;-webkit-user-select:none;user-select:none;
  display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;
}
.btn:active{transform:scale(.985)}
.btn[disabled]{opacity:.4;pointer-events:none}
/* Главная — единственный градиент на экране. Тёмный текст, а не
   белый: на светло-синем белый даёт меньше контраста, чем кажется. */
.btn.primary{background:var(--grad);color:#04121f;box-shadow:0 8px 22px -14px rgba(59,147,255,.9)}
.btn.primary:hover{opacity:.92}
/* Второстепенная — тональная, как filled tonal в Material: тот же
   акцент, но заливкой. Обводка тут лишняя, она делала кнопку
   похожей на поле ввода. */
.btn.secondary{background:var(--acc-dim);color:var(--acc);box-shadow:none}
.btn.secondary:hover{background:rgba(59,147,255,.22)}
.btn.danger{background:var(--bad-dim);color:var(--bad);box-shadow:none}
.btn.danger:hover{background:rgba(251,113,133,.22)}
.hint{color:var(--mut);padding:11px 13px;border-radius:var(--rs);border:0;background:var(--s2);font-size:13px;line-height:1.5;text-align:left}

/* ══ Отладка ══════════════════════════════════════════════════ */
.debug-section{margin-top:14px;padding-top:12px;border-top:1px solid rgba(255,255,255,.08)}
.debug-title{font-size:11.5px;font-weight:600;color:var(--dim);text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px;text-align:left}
.debug-body{display:block;margin-top:0}
.drow{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:7px 0;position:relative;font-size:13px}
.drow + .drow::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:rgba(255,255,255,.06)}
.drow-k{color:var(--dim)}
.drow-v{font-weight:500;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--acc);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px}
.copywrap{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.copyid{font-weight:600;font-size:14px}
.copybtn{border:0;background:var(--s3);color:var(--mut);border-radius:var(--rx);padding:5px 10px;cursor:pointer;min-height:30px;font:inherit;font-size:12px;font-weight:600;transition:background .12s,color .12s;touch-action:manipulation}
.copybtn:hover{background:var(--b1);color:var(--txt)}
.toast{display:inline-block;color:var(--ok);font-weight:600;opacity:0;transition:opacity .2s;font-size:12px}
.toast.on{opacity:1}
.hidden{display:none !important}

/* ══ Расширенные настройки ════════════════════════════════════ */
.adv-wrap{background:var(--s1);border:0;border-radius:var(--r);margin-bottom:12px;overflow:hidden;box-shadow:var(--edge)}
.adv-hdr{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:16px 18px;cursor:pointer;user-select:none;-webkit-user-select:none;transition:background .12s}
.adv-hdr:hover{background:rgba(255,255,255,.04)}
.adv-hdr-left{display:flex;align-items:center;gap:14px}
/* Значок в тональной плашке, а не голой эмодзи посреди строки. */
.adv-icon{
  width:36px;height:36px;border-radius:10px;flex:0 0 36px;font-size:19px;
  display:flex;align-items:center;justify-content:center;
  color:var(--acc);background:var(--acc-dim);
}
.adv-title{font-size:16px;font-weight:650;letter-spacing:-.25px}
.adv-sub{font-size:13px;color:var(--dim);margin-top:2px}
.adv-arr{font-size:18px;color:var(--dim);transition:transform .25s;width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.05);border-radius:50%;flex-shrink:0}
.adv-wrap.open .adv-arr{transform:rotate(180deg)}
.adv-body{display:none;border-top:1px solid rgba(255,255,255,.08)}
.adv-wrap.open .adv-body{display:block;animation:fadeUp .2s ease both}
.adv-inner{padding:var(--pad);display:flex;flex-direction:column;gap:10px}

/* ══ Бургер ═══════════════════════════════════════════════════ */
#burgerBtn{
  display:inline-flex;width:42px;height:42px;border:0;border-radius:var(--rs);
  background:var(--s2);color:var(--txt);font-size:20px;font-weight:650;cursor:pointer;
  touch-action:manipulation;-webkit-user-select:none;user-select:none;
  align-items:center;justify-content:center;flex-shrink:0;box-shadow:var(--edge);
  transition:background .12s,color .12s;
}
#burgerBtn:active{transform:scale(.95)}
#burgerBtn.is-open{background:var(--acc-dim);color:var(--acc);box-shadow:none}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* ══ Узкий экран ══════════════════════════════════════════════ */
@media(max-width:1200px){.main-grid{grid-template-columns:1fr 1fr}}
@media(max-width:800px){.main-grid,.bot-grid{grid-template-columns:1fr}}
@media(max-width:860px),(hover:none) and (pointer:coarse){
  .header{gap:8px;margin-bottom:8px}
  input,select{font-size:16px !important}
  .nav{width:min(280px,88vw)}
  .btn{min-height:44px}
  .wrap{padding-bottom:32px}
  .status-bar{gap:5px;flex-wrap:wrap}
  .si-left{padding:5px 10px;gap:6px}
  .si-right{display:none}
  .sname{font-size:11.5px}
  .si-wan .sval,.si-bypass .sval{font-size:11px}
  .card{padding:14px}
}

/* ══ Светлая тема ═════════════════════════════════════════════
   Мини-апп светлой темы не имеет вовсе — он фирменный и в обеих
   темах мессенджера выглядит одинаково. Здесь тема есть, и
   кнопка её переключения остаётся, поэтому светлый вариант
   выведен из той же системы: тот же акцент, те же радиусы, та же
   типографика, только уровни поверхности перевёрнуты.
   ═══════════════════════════════════════════════════════════ */
[data-theme="light"]{
  --bg:#eef2f8;
  --s1:#ffffff;--s2:#f3f6fb;--s3:#e7ecf5;
  --b1:rgba(15,23,42,.08);--b2:rgba(15,23,42,.14);
  --txt:#0f1929;--mut:#53627a;--dim:#8494ab;
  --acc:#1f6fe0;--acc2:#0e9fbd;--acc3:#1a5fc4;
  --acc-dim:rgba(31,111,224,.1);
  --grad:linear-gradient(135deg,#1f6fe0,#0e9fbd);
  --ok:#0f9d63;--ok-dim:rgba(15,157,99,.11);
  --warn:#b4730a;--warn-dim:rgba(180,115,10,.11);
  --bad:#d94a5e;--bad-dim:rgba(217,74,94,.1);
  --edge:0 1px 2px rgba(15,23,42,.05),0 1px 1px rgba(15,23,42,.03);
}
[data-theme="light"] body::before{
  background:radial-gradient(100% 100% at 50% 0%,rgba(31,111,224,.08),transparent 68%);
}
[data-theme="light"] .header{background:rgba(255,255,255,.86)}
[data-theme="light"] ::-webkit-scrollbar-thumb{background:rgba(15,23,42,.18)}
[data-theme="light"] .brand-icon{color:#fff}
[data-theme="light"] .btn.primary,[data-theme="light"] .nav a.primary,[data-theme="light"] .nav button.primary{color:#fff}
[data-theme="light"] .btn.primary{box-shadow:0 8px 22px -14px rgba(31,111,224,.9)}
[data-theme="light"] option{background:#fff;color:var(--txt)}
[data-theme="light"] select{
  background-image:linear-gradient(45deg,transparent 50%,rgba(15,25,41,.5) 50%),linear-gradient(135deg,rgba(15,25,41,.5) 50%,transparent 50%);
}
[data-theme="light"] .info-row + .info-row::before,
[data-theme="light"] .nav-header,
[data-theme="light"] .adv-body,
[data-theme="light"] .debug-section{border-color:rgba(15,23,42,.08)}
[data-theme="light"] .info-row + .info-row::before,
[data-theme="light"] .drow + .drow::before,
[data-theme="light"] .nav-sep{background:rgba(15,23,42,.08)}
[data-theme="light"] .nav a:hover,[data-theme="light"] .nav button:hover,
[data-theme="light"] .adv-hdr:hover{background:rgba(15,23,42,.04)}
[data-theme="light"] .nav a:active,[data-theme="light"] .nav button:active{background:rgba(15,23,42,.07)}
[data-theme="light"] .nav-close{background:var(--s3)}
[data-theme="light"] .nav-close:hover{background:rgba(15,23,42,.1)}
[data-theme="light"] .adv-arr{background:rgba(15,23,42,.05)}
[data-theme="light"] .si:hover{background:var(--s2)}
[data-theme="light"] #navOverlay{background:rgba(15,23,42,.4)}
[data-theme="light"] .nav{box-shadow:-8px 0 40px rgba(15,23,42,.12)}
[data-theme="light"] #atlTitle{color:var(--txt);-webkit-text-fill-color:currentColor}
[data-theme="light"] .nav-header-title{color:var(--txt);-webkit-text-fill-color:currentColor}

/* ══ Мастер первого запуска ═══════════════════════════════════ */
#wizOverlay{
  display:none;position:fixed;inset:0;z-index:500;
  background:rgba(4,8,14,.78);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  align-items:center;justify-content:center;padding:16px;
}
#wizOverlay.on{display:flex}
.wiz-box{width:100%;max-width:460px;background:var(--s1);border:0;border-radius:22px;overflow:hidden;box-shadow:var(--edge),0 32px 80px rgba(0,0,0,.5);animation:fadeUp .3s ease both}
.wiz-progress{height:4px;background:var(--s3)}
.wiz-progress-bar{height:4px;background:var(--acc);border-radius:999px;transition:width .4s cubic-bezier(.4,0,.2,1)}
.wiz-step{display:none;padding:26px 22px 22px;flex-direction:column;gap:16px}
.wiz-step.active{display:flex}
.wiz-icon{
  width:62px;height:62px;border-radius:50%;margin:4px auto 0;font-size:28px;
  display:flex;align-items:center;justify-content:center;
  color:var(--acc);background:var(--acc-dim);
}
.wiz-title{font-size:21px;font-weight:700;letter-spacing:-.5px;text-align:center}
.wiz-desc{font-size:14px;color:var(--mut);text-align:center;line-height:1.5}
.wiz-field{display:flex;flex-direction:column;gap:0}
.wiz-field label{font-size:13px;font-weight:400;color:var(--mut);text-transform:none;letter-spacing:0;margin:0 0 7px;text-align:left}
.wiz-actions{display:flex;gap:10px;margin-top:4px}
.wiz-actions .btn{flex:1;width:100%;padding:14px 18px;font-size:16px;border-radius:var(--rs)}
/* Пропуск — текстом со ссылочным подчёркиванием: в сплошном
   мелком тексте без него не отличить от подписи. */
.wiz-skip{background:none;border:none;color:var(--acc);font:inherit;font-size:13px;text-align:center;cursor:pointer;padding:4px;text-decoration:underline;text-underline-offset:2px}
.wiz-skip:hover{opacity:.8}
#wizWanPPP,#wizWanStatic{flex-direction:column;gap:12px}
.wiz-band-tabs{display:flex;background:var(--s2);border:0;border-radius:var(--rs);padding:4px;gap:4px}
.wiz-band{flex:1;padding:9px 0;border-radius:var(--rx);border:none;background:transparent;color:var(--mut);font:inherit;font-size:14px;font-weight:600;cursor:pointer;transition:background .15s,color .15s}
.wiz-band.active{background:var(--acc);color:#04121f;box-shadow:none}
[data-theme="light"] .wiz-band.active{color:#fff}
[data-theme="light"] #wizOverlay{background:rgba(15,23,42,.5)}
[data-theme="light"] .wiz-box{box-shadow:0 32px 80px rgba(15,23,42,.18)}

/* ══ Ожидание ═════════════════════════════════════════════════ */
@keyframes _spin{to{transform:rotate(360deg)}}
#loadingOverlay{display:none;position:fixed;inset:0;z-index:9000;background:rgba(4,8,14,.8);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);align-items:center;justify-content:center;flex-direction:column;gap:18px}
#loadingOverlay.on{display:flex !important}
.ld-ring{width:56px;height:56px;border:4px solid rgba(255,255,255,.1);border-top-color:var(--acc);border-radius:50%;animation:_spin .75s linear infinite}
.ld-text{font-size:17px;font-weight:650;letter-spacing:-.25px;color:#f0f4fa;text-align:center;max-width:280px;line-height:1.45}
.ld-sub{font-size:13px;color:#9aabc4;text-align:center;max-width:280px;margin-top:-10px}

/* Кому движение мешает — тому его нет. Системная настройка, не наша. */
@media (prefers-reduced-motion: reduce){
  .live-dot,.sdot.ok,.sdot.loading{animation:none}
  .btn,.wiz-progress-bar,.nav,.adv-wrap.open .adv-body,.wiz-box{transition:none;animation:none}
}

/* ══ Составные части из мини-аппа ══════════════════════════════
   Значок, тональная плашка под ним, группа строк с волосяным
   разделителем и шевроном, заголовок раздела. Это и есть та часть
   оформления, которую нельзя получить перекраской: строка со
   значком слева и шевроном справа читается нажимаемой, а строка
   без них — просто текстом.
   ═══════════════════════════════════════════════════════════ */
.ic{width:20px;height:20px;flex:0 0 auto;display:block}
.ic-lg{width:26px;height:26px}
/* Значок сидит в тональной плашке, а не висит в воздухе: так он
   отделён от текста и держит левый край списка. */
.ic-box{
  width:36px;height:36px;border-radius:10px;flex:0 0 36px;
  display:flex;align-items:center;justify-content:center;
  color:var(--acc);background:var(--acc-dim);
}
.ic-box .ic{width:19px;height:19px}
.ic-box.ok{color:var(--ok);background:var(--ok-dim)}
.ic-box.warn{color:var(--warn);background:var(--warn-dim)}
.ic-box.bad{color:var(--bad);background:var(--bad-dim)}
/* Заголовок раздела — как в настройках телефона: мелкий,
   приглушённый, капителью, вне рамки. */
.sec{margin:20px 4px 9px;font-size:11.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--dim)}
.sec:first-child{margin-top:4px}
.list{background:var(--s1);border-radius:var(--r);overflow:hidden;margin-bottom:12px;box-shadow:var(--edge)}
.item{
  display:flex;align-items:center;gap:13px;padding:13px var(--pad);position:relative;
  width:100%;border:0;background:none;color:inherit;font:inherit;text-align:left;
}
/* Разделитель начинается от текста, а не от края: так глаз видит,
   где строка кончается содержательно, и группа читается блоком. */
.item + .item::before{content:'';position:absolute;top:0;left:var(--pad);right:0;height:1px;background:rgba(255,255,255,.08)}
.list.leading .item + .item::before{left:65px}
button.item{cursor:pointer;transition:background .12s}
button.item:active{background:rgba(255,255,255,.05)}
.item .chev{color:var(--dim);flex:0 0 auto}
.item b{font-weight:600}
.grow{flex:1;min-width:0}
.ellip{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.muted{color:var(--mut)}
.small{font-size:13px}
.pill{font-size:12px;font-weight:600;padding:3px 10px;border-radius:999px;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.pill.ok{color:var(--ok);background:var(--ok-dim)}
.pill.warn{color:var(--warn);background:var(--warn-dim)}
.pill.bad{color:var(--bad);background:var(--bad-dim)}
.pill.off{color:var(--mut);background:rgba(154,171,196,.12)}
.dot{width:6px;height:6px;border-radius:50%;background:currentColor}
.pill.ok .dot{animation:lpulse 2.6s ease-in-out infinite}
[data-theme="light"] .item + .item::before{background:rgba(15,23,42,.08)}
[data-theme="light"] button.item:active{background:rgba(15,23,42,.05)}
[data-theme="light"] .pill.off{background:rgba(83,98,122,.12)}
/* Размер значка по месту. Один .ic на 20 пикселей не годится
   везде: в кнопке он спорит с подписью, в заголовке наоборот
   теряется. */
.btn .ic{width:17px;height:17px}
.card-title .ic{width:20px;height:20px}
.acc-title{display:inline-flex;align-items:center;gap:9px}
.acc-title .ic{width:18px;height:18px;color:var(--acc)}
.acc-arrow .ic,.adv-arr .ic{width:18px;height:18px}
.acc-arrow{display:inline-flex}
.adv-icon .ic{width:19px;height:19px}
.nav a .ic,.nav button .ic{width:19px;height:19px;color:var(--mut)}
.nav a.primary .ic,.nav button.primary .ic{color:inherit}
.nav-home-btn .ic{color:var(--acc) !important}
.pw-eye{display:flex;align-items:center}
.pw-eye .ic{width:19px;height:19px}
.copybtn{display:inline-flex;align-items:center;justify-content:center}
.copybtn .ic{width:15px;height:15px}
/* Внутри чипа кнопка копирования идёт без подложки: своя заливка
   в 10-пиксельном поле пилюли давала коробку в коробке, и чип
   переставал читаться одним элементом. */
.mchip .copybtn{background:none;border:0;padding:2px;min-height:auto;color:var(--dim)}
.mchip .copybtn:hover{background:none;color:var(--txt)}
/* Галочка «скопировано» не должна раздвигать чип, пока её не видно. */
.mchip .toast{width:0;overflow:hidden;transition:width .2s,opacity .2s}
.mchip .toast.on{width:15px}
.toast .ic{width:15px;height:15px}
.ir-label{display:inline-flex;align-items:center;gap:7px}
.ir-label .ic{width:16px;height:16px;color:var(--dim)}
.wiz-icon .ic{width:28px;height:28px}
/* Значок на экране перезагрузки крутится сам — размер задаём тут,
   в разметке у него только класс. */
.icon .ic{width:56px;height:56px;color:var(--acc)}
</style>
</head>
<body>
