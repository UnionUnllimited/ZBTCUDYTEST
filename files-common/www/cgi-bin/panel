    var m = g('modal'); if(m) m.style.display='flex';
  }
  updateWanFields();
  // Stagger card animations
  var cards = document.querySelectorAll('.card');
  for(var i=0;i<cards.length;i++){
    cards[i].style.opacity = '0';
    cards[i].style.animation = 'fadeUp .35s ' + (0.05 + i*0.035) + 's ease both';
    cards[i].style.animationFillMode = 'both';
  }
  initSsidFields();
  // Статус обновления отрисован сервером в data-атрибутах — расшифровываем
  // теми же строками, что потом придут из опроса.
  var _otaEl = g('ota-status');
  if(_otaEl) otaSetStatus(_otaEl.getAttribute('data-code'), _otaEl.getAttribute('data-at'));
  if(/[?&]ota=1/.test(location.search)){
    var _uh = document.querySelector('.acc-hdr[data-id="update"]');
    if(_uh){
      if(!_uh.classList.contains('open')) accToggle(_uh);
      setTimeout(function(){ _uh.scrollIntoView({behavior:'smooth', block:'center'}); }, 150);
    }
    _otaMinPolls = 6;
    otaPoll();
  }
  // Bypass wait: если только что нажали включить/выключить VPN — ждём запуска сервиса
  var _bw = ((location.search.match(/[?&]bw=(\d+)/) || [0,0])[1] | 0);
  var _nc_param = (location.search.match(/[?&]nc=([^&]*)/) || ['',''])[1];
  if(_nc_param){ try{ _nc_param = decodeURIComponent(_nc_param); }catch(e){ _nc_param=''; } }
  if(_bw > 0){
    var bsd = g('sdot-bypass'); if(bsd) bsd.className='sdot loading';
    var bsv = g('sv-bypass'); if(bsv) bsv.textContent='Применяется...';
    var blc = g('bypass-label-card'); if(blc) blc.textContent='Применяется...';
    var bsdh = g('sdot-bypass-hdr'); if(bsdh) bsdh.className='sdot loading';
    var bsvh = g('sv-bypass-hdr'); if(bsvh) bsvh.textContent='Применяется...';
    var bbtn = g('bypassBtn'); if(bbtn) bbtn.disabled=true;
    setTimeout(function(){
      if(bbtn) bbtn.disabled=false;
      pollStatus();
      // Автопроверки после смены сервера здесь больше нет.
      //
      // Раньше она стучалась curl'ом в порт узла — дёшево, но неверно:
      // на VLESS и Reality такой стук законно не отвечает, и панель
      // писала «порт сервера закрыт» про полностью рабочий сервер.
      // Теперь проверка идёт настоящая, через сам узел, и стоит дорого:
      // временный канал на каждый сервер, до минуты на все. Запускать
      // это автоматически, да ещё поверх перезапуска PassWall, который
      // прямо сейчас идёт после смены узла, — верный способ положить
      // роутер. Проверка осталась на кнопке URL Test, как в PassWall.
    }, _bw*1000);
  } else {
    pollStatus();
  }
  setInterval(pollStatus, 30000);
  fetchDevices();
  fetchStats();
  setInterval(fetchDevices, 20000);
  setInterval(fetchStats, 30000);
  // pingNodes() при загрузке больше не зовём: проверка стала настоящей,
  // с временным каналом на каждый узел и минутой на всё. Открывать этим
  // каждую страницу панели нельзя — только по кнопке.
  // Авто-закрытие уведомлений через 4 сек
  document.querySelectorAll('.msg,.err').forEach(function(el){
    setTimeout(function(){
      el.style.transition='opacity .5s';
      el.style.opacity='0';
      setTimeout(function(){ el.style.display='none'; }, 500);
    }, 4000);
  });
});

// ── Роутинг: ?page=adv → страница расширенных настроек ──────
(function(){
  var params = new URLSearchParams(location.search);
  if(params.get('page') !== 'adv') return;

  // Прячем главные карточки
  var mc = document.getElementById('mainCards');
  if(mc) mc.style.display = 'none';

  // Показываем и раскрываем расширенные настройки
  var adv = document.getElementById('advSection');
  if(!adv) return;
  adv.style.display = 'block';
  adv.classList.add('open');

  // Раскрываем тело adv-wrap
  var body = document.getElementById('advBody');
  if(body) body.style.display = 'block';

  // Раскрываем все внутренние аккордеоны
  adv.querySelectorAll('.acc-hdr').forEach(function(h){
    h.classList.add('open');
    var id = h.getAttribute('data-id');
    var ab = document.getElementById('acc-' + id);
    if(ab) ab.style.display = 'block';
  });

  // Делаем заголовок adv-hdr не кликабельным (мы уже открыты)
  var hdr = document.getElementById('advHdr');
  if(hdr){ hdr.style.cursor = 'default'; hdr.onclick = null; }
  var arr = document.getElementById('advArr');
  if(arr) arr.style.display = 'none';

  // Кнопка «← Назад» перед содержимым
  var wrap = document.querySelector('.wrap');
  if(wrap){
    var back = document.createElement('button');
    back.className = 'btn secondary';
    back.style.cssText = 'margin-bottom:10px;width:auto;padding:8px 18px;font-size:13px';
    back.innerHTML = '← Назад';
    back.onclick = function(){ window.location.href = location.pathname; };
    wrap.insertBefore(back, wrap.firstChild);
  }
})();
</script>
