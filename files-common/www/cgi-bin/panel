<!-- ══ Мастер первого запуска ═══════════════════════════════ -->
<div id="wizOverlay">
  <div class="wiz-box">
    <div class="wiz-progress"><div class="wiz-progress-bar" id="wizBar" style="width:0%"></div></div>

    <!-- Шаг 0: Добро пожаловать -->
    <div class="wiz-step active" id="wiz0">
      <div class="wiz-icon"><svg class="ic ic-lg"><use href="#i-wand"/></svg></div>
      <div class="wiz-title">Добро пожаловать в Titan Router!</div>
      <div class="wiz-desc">Настроим роутер за 3 шага:<br>Wi-Fi, интернет, пароль</div>
      <div class="wiz-actions">
        <button class="btn primary" type="button" onclick="wizNext()">Начать настройку<svg class="ic"><use href="#i-chev-r"/></svg></button>
      </div>
      <a href="/instruction/" style="display:block;margin-top:8px;font-size:12px;color:var(--acc);text-align:center;text-decoration:underline">Прочитать инструкцию перед началом</a>
      <button class="wiz-skip" type="button" onclick="wizFinish(true)">Пропустить, настрою позже</button>
    </div>

    <!-- Шаг 1: WiFi -->
    <div class="wiz-step" id="wiz1">
      <div class="wiz-icon"><svg class="ic ic-lg"><use href="#i-wifi"/></svg></div>
      <div class="wiz-title">Настройка WiFi</div>
      <div class="wiz-desc">Префикс <b>Titan-</b> добавится автоматически.<br>Пароль один для обеих сетей.</div>
      <div class="wiz-band-tabs">
        <button type="button" class="wiz-band active" id="wizBand24Btn" onclick="wizBandSwitch('24')">2.4 ГГц</button>
        <button type="button" class="wiz-band" id="wizBand5Btn" onclick="wizBandSwitch('5')">5 ГГц</button>
      </div>
      <!-- 2.4 ГГц -->
      <div id="wizBand24">
        <div class="wiz-field">
          <label>Имя сети 2.4 ГГц (SSID)</label>
          <div style="display:flex;align-items:center;gap:0">
            <span style="background:var(--s3);border:1px solid var(--b1);border-right:0;border-radius:8px 0 0 8px;padding:9px 10px;font-size:13px;font-weight:700;color:var(--acc);white-space:nowrap;min-height:40px;display:flex;align-items:center;flex-shrink:0">Titan-</span>
            <input class="inp" id="wizSsid" type="text" placeholder="MyHome" autocomplete="off" spellcheck="false" style="border-radius:0 8px 8px 0;flex:1;margin:0">
          </div>
        </div>
        <div class="wiz-field">
          <label>Пароль (мин. 8 символов)</label>
          <div class="pw-wrap">
            <input class="inp" id="wizKey" type="password" placeholder="Минимум 8 символов" autocomplete="new-password">
            <button class="pw-eye" type="button" onclick="togglePw('wizKey')"><svg class="ic"><use href="#i-eye"/></svg></button>
          </div>
        </div>
      </div>
      <!-- 5 ГГц -->
      <div id="wizBand5" style="display:none">
        <div class="wiz-field">
          <label>Имя сети 5 ГГц (SSID)</label>
          <div style="display:flex;align-items:center;gap:0">
            <span style="background:var(--s3);border:1px solid var(--b1);border-right:0;border-radius:8px 0 0 8px;padding:9px 10px;font-size:13px;font-weight:700;color:var(--acc);white-space:nowrap;min-height:40px;display:flex;align-items:center;flex-shrink:0">Titan-</span>
            <input class="inp" id="wizSsid5" type="text" placeholder="MyHome-5G" autocomplete="off" spellcheck="false" style="border-radius:0 8px 8px 0;flex:1;margin:0">
          </div>
        </div>
        <div class="wiz-field">
          <label>Пароль (мин. 8 символов)</label>
          <div class="pw-wrap">
            <input class="inp" id="wizKey5" type="password" placeholder="Минимум 8 символов" autocomplete="new-password">
            <button class="pw-eye" type="button" onclick="togglePw('wizKey5')"><svg class="ic"><use href="#i-eye"/></svg></button>
          </div>
        </div>
        <div style="font-size:11px;color:var(--dim);text-align:center;margin-top:2px">Если оставить пустым — скопируется из 2.4 ГГц</div>
      </div>
      <div id="wizWifiErr" style="color:var(--bad);font-size:12px;display:none"></div>
      <div class="wiz-actions">
        <button class="btn secondary" type="button" onclick="wizPrev()"><svg class="ic"><use href="#i-chev-l"/></svg>Назад</button>
        <button class="btn primary" type="button" onclick="wizNext()">Далее<svg class="ic"><use href="#i-chev-r"/></svg></button>
      </div>
      <button class="wiz-skip" type="button" onclick="wizNext(true)">Пропустить этот шаг</button>
    </div>

    <!-- Шаг 2: WAN / Интернет -->
    <div class="wiz-step" id="wiz2">
      <div class="wiz-icon"><svg class="ic ic-lg"><use href="#i-globe"/></svg></div>
      <div class="wiz-title">Подключение к интернету</div>
      <div class="wiz-desc">Выберите тип подключения вашего провайдера.</div>
      <div class="wiz-field">
        <label>Тип подключения</label>
        <select class="inp" id="wizWanProto" onchange="wizWanChange()">
          <option value="dhcp">DHCP — автоматически (чаще всего)</option>
          <option value="pppoe">PPPoE — логин и пароль провайдера</option>
          <option value="static">Static IP — статический адрес</option>
          <option value="l2tp">L2TP</option>
          <option value="pptp">PPTP</option>
        </select>
      </div>
      <!-- PPPoE / L2TP / PPTP -->
      <div id="wizWanPPP" style="display:none;flex-direction:column;gap:10px">
        <div class="wiz-field">
          <label>Логин провайдера</label>
