// ── Ping nodes ───────────────────────────────────────────────
var _pingCache = {};

// Имя сервера без метки пинга.
//
// Раньше метку отрезали регуляркой по хвосту текста, и это не работало:
// option.text по спецификации возвращает текст со схлопнутыми пробелами,
// а дописывали метку через два. Регулярка искала два пробела, находила
// один, старую метку не срезала — и каждый прогон теста добавлял ещё
// одну. Отсюда «Германия ✗ ✗».
//
// Плюс класс [🟢🟡🔴] в регулярке без флага u разбирается как половинки
// суррогатных пар, так что цветные метки не срезались вообще никогда.
//
// Поэтому чистое имя запоминаем один раз, при первом касании, и дальше
// всегда строим подпись от него.
function nodeBaseLabel(opt){
  var b = opt.getAttribute('data-base');
  if(b === null){ b = opt.text; opt.setAttribute('data-base', b); }
  return b;
}
function nodeSetPing(opt, ms){
  var base = nodeBaseLabel(opt);
  // undefined — узла нет в ответе (например балансер), -3 — не успели
  // проверить по дедлайну. И то и другое значит «не знаем», а не «мёртв»:
  // метку не ставим вовсе, чтобы не врать.
  if(ms === undefined || ms === -3){ opt.text = base; return; }
  if(ms >= 0){
    var c = ms < 80 ? '🟢' : ms < 200 ? '🟡' : '🔴';
    opt.text = base + '  ' + c + ' ' + ms + 'ms';
  } else if(ms === -2){
    opt.text = base + '  ⏰ тайм';
  } else {
    opt.text = base + '  ✗';
  }
}

function pingNodes(){
  var btn = g('pingBtn');
  var status = g('ping-status');
  var sel = g('pw_node');
  if(!sel) return;
  if(btn){ btn.disabled = true; btn.textContent = '⏳…'; }
  // Проверка идёт через сами узлы и потому небыстрая: на каждый
  // поднимается временный канал. Честно предупреждаем, иначе выглядит
  // как зависшая кнопка.
  if(status) status.textContent = 'Проверяем серверы по очереди, до минуты…';

  fetch('/cgi-bin/panel?action=api_ping_nodes', {credentials:'include'})
    .then(function(r){ return r.json(); })
    .then(function(data){
      _pingCache = data;
      // Обновляем опции select
      var opts = sel.options;
      for(var i = 0; i < opts.length; i++){
        nodeSetPing(opts[i], data[opts[i].value]);
      }
      if(btn){ btn.disabled = false; btn.textContent = '🏓 URL Test'; }
      if(status) status.textContent = '✅ Выберите сервер с наименьшей задержкой';
      setTimeout(function(){ if(status) status.textContent = ''; }, 4000);
    })
    .catch(function(e){
      if(btn){ btn.disabled = false; btn.textContent = '🏓 URL Test'; }
      if(status) status.textContent = '❌ Ошибка URL Test';
    });
}

