var OTA_STATUS_TXT = {
  ok:               'обновление установлено',
  no_update:        'стоит последняя версия',
  update_available: 'есть версия новее',
  not_in_rollout:   'версия есть, очередь роутера ещё не подошла',
  no_image:         'в манифесте нет образа для этой модели',
  download_failed:  'не удалось скачать образ',
  sha_mismatch:     'контрольная сумма не совпала',
