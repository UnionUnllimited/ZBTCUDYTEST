.info-hint{display:flex;align-items:flex-start;gap:8px;padding:9px 12px;border-radius:var(--rx);background:rgba(100,116,139,.07);border:1px solid rgba(100,116,139,.14);color:var(--mut);font-size:11px;line-height:1.5;margin:0 0 10px}
.info-hint.warn{background:rgba(240,176,48,.07);border-color:rgba(240,176,48,.18);color:var(--warn)}
