<script>
function tPw(){var e=document.getElementById('lp');if(!e)return;var p=e.type==='password';e.type=p?'text':'password';var b=e.nextElementSibling;if(b)b.textContent=p?'Скрыть':'Показать';}
async function cpMac(){var e=document.getElementById('mac');var t=e?e.textContent.trim():'';if(!t)return;try{await navigator.clipboard.writeText(t);}catch(ex){var a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();document.execCommand('copy');a.remove();}var s=document.getElementById('cp');if(s){s.classList.add('on');setTimeout(function(){s.classList.remove('on');},1200);}}
function wizSetTheme(t){
  applyTheme(t);
  try{localStorage.setItem('atlTheme',t);}catch(e){}
  var bl=document.getElementById('wizThemeLight'),bd=document.getElementById('wizThemeDark');
  if(bl) bl.style.borderColor=t==='light'?'var(--acc)':'var(--b2)';
  if(bd) bd.style.borderColor=t==='dark'?'var(--acc)':'var(--b2)';
}
function applyTheme(t){document.documentElement.setAttribute('data-theme',t||'light');var b=document.getElementById('themeBtn');if(b)b.textContent=(t==='dark')?'Светлая':'Тёмная';}
function toggleTheme(){var c=document.documentElement.getAttribute('data-theme')||'light';var n=c==='light'?'dark':'light';applyTheme(n);try{localStorage.setItem('atlTheme',n);}catch(e){}}
(function(){try{var t=localStorage.getItem('atlTheme')||'light';applyTheme(t);}catch(e){applyTheme('light');}})();
