SUB_BANNER=""
if [ "$SUB_UNPAID" = "1" ]; then
  SUB_BANNER='<div class="sub-unpaid" style="margin:0 0 12px;padding:16px 18px;border-radius:16px;background:linear-gradient(135deg,#e23a3a,#b81f1f);border:1px solid rgba(255,120,120,.55);box-shadow:0 6px 28px rgba(200,0,0,.28)">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
      <span><svg class="ic ic-lg"><use href="#i-alert"/></svg></span>
      <span style="font-size:16px;font-weight:800;color:#fff">Подписка не оплачена</span>
    </div>
    <p style="margin:0 0 14px;color:#ffe2e2;line-height:1.55;font-size:13px">Доступ к VPN приостановлен. Чтобы продолжить пользоваться сервисом, оплатите подписку на сайте или через Telegram-бота.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <span style="flex:1;min-width:150px;text-align:center;padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.55);color:#8a1515;font-weight:800;cursor:not-allowed;opacity:.85">💳 Оплатить на сайте — временно недоступно</span>
      <a href="https://t.me/TitanVPSHelp_bot" target="_blank" rel="noopener" style="flex:1;min-width:150px;text-align:center;padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.45);color:#fff;font-weight:800;text-decoration:none">🤖 Оплатить в боте</a>
    </div>
  </div>'
fi

SEL_DHCP=""; SEL_PPPOE=""; SEL_L2TP=""; SEL_PPTP=""; SEL_STATIC=""
case "$CUR_WAN" in
