# ─── API: URL Test серверов ────────────────────────────────────
# Зовём штатный PassWall, а не меряем сами.
#
# Своя проверка стучалась curl'ом прямо в порт узла и считала живым
# только то, что ответило по HTTP. Но на этих портах VLESS и Reality,
# отвечать по HTTP они не обязаны — и все узлы поголовно показывались
# как «✗», хотя туннель через них работал. В списке узлов самого
# PassWall при этом видно обратное: TCPing может стоять Timeout, а
# URL Test — 1219 ms, потому что он меряет иначе.
#
# test.sh url_test_node поднимает временный SOCKS через саму ноду и
# гонит сквозь неё настоящий запрос, возвращая «код:время». Это и есть
# честная проверка, и повторять её своими силами незачем.
#
# Цена — время: на каждый узел временный xray, пауза 2с и запрос до 5с.
# Поэтому строго последовательно (пять xray разом эту железку положат)
# и с дедлайном: uhttpd убивает CGI через 60 секунд.
if [ "${GET_ACT:-}" = "api_ping_nodes" ]; then
  echo "Content-type: application/json; charset=utf-8"
  echo "Cache-Control: no-store, no-cache"
  echo ""
  PW_TEST="/usr/share/passwall/test.sh"
  _pdir="/tmp/atl_ping_$$"
  if ! mkdir -p "$_pdir" 2>/dev/null; then printf '{}'; exit 0; fi

  # Подчищаем xray от прерванного прошлого прогона: если CGI убили по
  # таймауту, его временные процессы остаются висеть и едят память.
  for _stale in $(pgrep -f 'url_test_.*\.json' 2>/dev/null || true); do
    kill -9 "$_stale" 2>/dev/null || true
  done
  # Собираем ноды через pw_nodes_list (те же секции что в select).
  # Балансер отсеивается сам: у него нет address, а тестировать группу
  # нечем — url_test_node работает с конкретным узлом.
  pw_nodes_list 2>/dev/null > "$_pdir/seclist.txt" || true
  _n=0
  while IFS="$(printf '\t')" read -r _sec _rem; do
    [ -n "$_sec" ] || continue
    _addr="$(uci -q get passwall."$_sec".address 2>/dev/null || true)"
    [ -n "$_addr" ] || continue
    _n=$((_n+1))
    printf '%s\t%s\n' "$_n" "$_sec"
  done < "$_pdir/seclist.txt" > "$_pdir/nodes.txt" 2>/dev/null || true
  # Последовательно и с дедлайном. Узлы, до которых не успели, отдаём
  # как -3 — панель покажет их без метки, а не соврёт про «мёртв».
  _deadline=$(( $(date +%s) + 30 ))
  while IFS="$(printf '\t')" read -r _num _sec; do
    [ -n "$_num" ] && [ -n "$_sec" ] || continue
    _nf="$_pdir/r_$_num"
    _sf="$_pdir/s_$_num"
    printf '%s' "$_sec" > "$_sf"
    (
      _ms="-3"
      if [ -x "$PW_TEST" ] && [ "$(date +%s)" -lt "$_deadline" ]; then
        # Отдаёт «код:время», например 204:0.214000
        _raw="$(sh "$PW_TEST" url_test_node "$_sec" 2>/dev/null | tail -n1)"
        _code="${_raw%%:*}"
        _time="${_raw#*:}"
        case "$_code" in
          200|204|301|302)
            _ms="$(awk "BEGIN{v=${_time:-0}*1000; printf \"%d\", (v<1)?1:v}" 2>/dev/null || echo "-1")"
            ;;
          *) _ms="-1" ;;
        esac
      fi
      printf '%s' "$_ms" > "$_nf"
    )
  done < "$_pdir/nodes.txt"

  # Собираем JSON по номерам — без glob по спецсимволам
  _json='{'
  _sep=''
  _i=1
  while [ -f "$_pdir/s_$_i" ]; do
    _s="$(cat "$_pdir/s_$_i" 2>/dev/null || true)"
    _m="$(cat "$_pdir/r_$_i" 2>/dev/null || true)"
    [ -n "$_s" ] && _json="${_json}${_sep}\"${_s}\":${_m:--1}" && _sep=','
    _i=$((_i+1))
  done
  _json="${_json}}"
  printf '%s' "$_json"
  rm -rf "$_pdir"
  exit 0
fi



