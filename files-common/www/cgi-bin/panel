    # — WiFi 2.4 ГГц —
    ss24_raw="$(printf "%s" "${FORM_ssid_24:-}" | strip_newlines)"
    ss24_chk="$(printf "%s" "$ss24_raw" | trim_spaces)"
    if [ -n "$ss24_chk" ]; then
      is_ascii "$ss24_raw" || redir "" "SSID: только латиница, цифры, пробелы." ""
      case "$ss24_raw" in Titan-*|titan-*) : ;; *) ss24_raw="Titan-${ss24_raw}" ;; esac
      k24="$(printf "%s" "${FORM_key_24:-}" | strip_newlines)"
      if [ -n "$k24" ]; then
        len_ge_8 "$k24" || redir "" "Пароль WiFi: минимум 8 символов." ""
        is_ascii_nospace "$k24" || redir "" "Пароль WiFi: латиница без пробелов." ""
      fi
      uci -q set wireless.default_radio0.ssid="$ss24_raw" 2>/dev/null || true
      if [ -n "$k24" ]; then
        uci -q set wireless.default_radio0.encryption="psk2" 2>/dev/null || true
        uci -q set wireless.default_radio0.key="$k24" 2>/dev/null || true
      else
        uci -q set wireless.default_radio0.encryption="none" 2>/dev/null || true
        uci -q delete wireless.default_radio0.key 2>/dev/null || true
      fi
      uci -q set wireless.default_radio0.disabled="0" 2>/dev/null || true
      # — WiFi 5 ГГц —
      ss5_raw="$(printf "%s" "${FORM_ssid_5:-}" | strip_newlines)"
      ss5_chk="$(printf "%s" "$ss5_raw" | trim_spaces)"
      k5="$(printf "%s" "${FORM_key_5:-}" | strip_newlines)"
      if [ -n "$ss5_chk" ] && uci -q get wireless.radio1.type >/dev/null 2>&1; then
        is_ascii "$ss5_raw" || true
        case "$ss5_raw" in Titan-*|titan-*) : ;; *) ss5_raw="Titan-${ss5_raw}" ;; esac
        uci -q set wireless.default_radio1.ssid="$ss5_raw" 2>/dev/null || true
        if [ -n "$k5" ]; then
          uci -q set wireless.default_radio1.encryption="psk2" 2>/dev/null || true
          uci -q set wireless.default_radio1.key="$k5" 2>/dev/null || true
        else
          uci -q set wireless.default_radio1.encryption="none" 2>/dev/null || true
          uci -q delete wireless.default_radio1.key 2>/dev/null || true
        fi
        uci -q set wireless.default_radio1.disabled="0" 2>/dev/null || true
      fi
      uci -q commit wireless 2>/dev/null || true
      { wifi down >/dev/null 2>&1 || true; sleep 2; wifi up >/dev/null 2>&1 || true; } </dev/null >/dev/null 2>&1 &
    fi
    # — WAN / Интернет —
    wiz_proto="$(printf "%s" "${FORM_wan_proto:-}" | strip_newlines | trim_spaces)"
    if [ -n "$wiz_proto" ]; then
      IFACE="$(detect_wan_iface)"
      uci -q get network."$IFACE" >/dev/null 2>&1 || uci -q set network."$IFACE"=interface 2>/dev/null || true
      uci -q delete network."$IFACE".dns 2>/dev/null || true
      case "$wiz_proto" in
        dhcp)
          uci -q set network."$IFACE".proto="dhcp" 2>/dev/null || true
          uci -q delete network."$IFACE".username 2>/dev/null || true
          uci -q delete network."$IFACE".password 2>/dev/null || true
          uci -q delete network."$IFACE".server 2>/dev/null || true
          uci -q delete network."$IFACE".peeraddr 2>/dev/null || true
          ;;
        pppoe|l2tp|pptp)
          wu="$(printf "%s" "${FORM_pppoe_user:-}" | strip_newlines)"
          wp="$(printf "%s" "${FORM_pppoe_pass:-}" | strip_newlines)"
          is_ascii "$wu" || redir "" "WAN логин: только латиница." ""
          is_ascii "$wp" || redir "" "WAN пароль: только латиница." ""
          uci -q set network."$IFACE".proto="$wiz_proto" 2>/dev/null || true
          uci -q set network."$IFACE".username="$wu" 2>/dev/null || true
          uci -q set network."$IFACE".password="$wp" 2>/dev/null || true
          ws="$(printf "%s" "${FORM_l2tp_server:-}" | strip_newlines | trim_spaces)"
          if [ -n "$ws" ]; then
            uci -q set network."$IFACE".server="$ws" 2>/dev/null || true
          else
            uci -q delete network."$IFACE".server 2>/dev/null || true
          fi
          ;;
        static)
          wip="$(printf "%s" "${FORM_static_ip:-}"   | trim_spaces)"
          wmask="$(printf "%s" "${FORM_static_mask:-255.255.255.0}" | trim_spaces)"
          wgw="$(printf "%s" "${FORM_static_gw:-}"   | trim_spaces)"
          wd1="$(printf "%s" "${FORM_static_dns1:-}"  | trim_spaces)"
          is_ipv4 "$wip"   || redir "" "Статический IP: неверный адрес." ""
          is_ipv4 "$wmask" || redir "" "Статический IP: неверная маска." ""
          [ -n "$wgw" ] && ! is_ipv4 "$wgw" && redir "" "Шлюз: неверный адрес." ""
          [ -n "$wd1" ] && ! is_ipv4 "$wd1" && redir "" "DNS: неверный адрес." ""
          uci -q set network."$IFACE".proto="static" 2>/dev/null || true
          uci -q set network."$IFACE".ipaddr="$wip" 2>/dev/null || true
          uci -q set network."$IFACE".netmask="$wmask" 2>/dev/null || true
          [ -n "$wgw" ] && uci -q set network."$IFACE".gateway="$wgw" 2>/dev/null || true
          [ -n "$wd1" ] && uci -q add_list network."$IFACE".dns="$wd1" 2>/dev/null || true
          uci -q delete network."$IFACE".username 2>/dev/null || true
          uci -q delete network."$IFACE".password 2>/dev/null || true
          uci -q delete network."$IFACE".server 2>/dev/null || true
          ;;
      esac
      uci -q commit network 2>/dev/null || true
      { ifdown "$IFACE" >/dev/null 2>&1 || true; ifup "$IFACE" >/dev/null 2>&1 || true; } </dev/null >/dev/null 2>&1 &
    fi
    # — Учётные данные панели —
    nu="$(printf "%s" "${FORM_new_user:-}" | trim_spaces)"
    np="$(printf "%s" "${FORM_new_pass:-}" | strip_newlines)"
    if [ -n "$nu" ] && [ -n "$np" ]; then
      len_ge_5 "$nu" || redir "" "Логин: минимум 5 символов." ""
      len_ge_8 "$np" || redir "" "Пароль панели: минимум 8 символов." ""
      is_ascii_nospace "$nu" || redir "" "Логин: только латиница без пробелов." ""
      setcfg user "$nu"; setcfg pass "$np"
    fi
    setcfg setup_done "1"
    commitcfg
    redir "Настройка завершена! Добро пожаловать в Titan Router." "" ""
    ;;
  passwall_update)
    pw_exists || redir "" "VPN не настроен." ""
    NOW="$(date +%s)"
    if [ -f "$LOCK" ]; then
      TS="$(cat "$LOCK" 2>/dev/null || echo 0)"; AGE=$((NOW - TS))
      [ "$AGE" -ge 0 ] && [ "$AGE" -lt 300 ] && redir "Обновление уже выполняется. Подождите 30 сек." "" ""
    fi
    echo "$NOW" > "$LOCK" 2>/dev/null || true
    chmod 666 "$LOCK" 2>/dev/null || true
    # Запускаем в фоне — сразу редиректим (иначе Bad Gateway)
    {
      lua /usr/share/passwall/rule_update.lua >>"$LOG" 2>&1 || true
      lua /usr/share/passwall/subscribe.lua >>"$LOG" 2>&1 || true
      rm -f "$LOCK" 2>/dev/null || true
    } </dev/null >/dev/null 2>&1 &
    redir "Обновление запущено в фоне. Займёт 15–30 сек." "" ""
    ;;
  ota_check)
    ota_ready || redir "" "Обновление не настроено: адрес манифеста пуст."
    if ota_busy; then redir "Проверка уже идёт, подождите." ""; fi
    ota_spawn check
    # Карточка обновления живёт на странице расширенных настроек,
    # поэтому возвращаемся сразу туда, иначе ход проверки не виден.
    echo "Status: 303 See Other"
    echo "Location: /cgi-bin/panel?page=adv&ota=1&m=$(qenc 'Проверяем обновление…')"
    echo ""; exit 0
    ;;
  ota_update_now)
    ota_ready || redir "" "Обновление не настроено: адрес манифеста пуст."
    if ota_busy; then redir "Обновление уже идёт, подождите." ""; fi
    # То же самое, что делает cron ночью, только без ожидания своей
    # волны раскатки и без случайной задержки внутри часа.
    ota_spawn now
    echo "Status: 303 See Other"
    echo "Location: /cgi-bin/panel?page=adv&ota=1&m=$(qenc 'Обновление запущено. Если есть версия новее — роутер скачает её и перезагрузится сам.')"
    echo ""; exit 0
    ;;
  pw_change_node)
    pw_exists || redir "" "VPN не настроен." ""
    [ -n "${FORM_pw_node:-}" ] || redir "" "Не выбран сервер." ""
    pw_apply_node "$FORM_pw_node"
    _enc_node="$(qenc "$FORM_pw_node")"
    echo "Status: 303 See Other"
    echo "Location: /cgi-bin/panel?m=$(qenc 'Сервер изменён.')&e=&bw=8&nc=${_enc_node}"
    echo ""
    exit 0
    ;;
  guest_enable)
    gssid="$(printf "%s" "${FORM_ssid_guest:-Titan-Guest}" | strip_newlines | trim_spaces)"
    gkey="$(printf "%s" "${FORM_key_guest:-}" | strip_newlines)"
    [ -z "$gssid" ] && gssid="Titan-Guest"
    if [ -n "$gkey" ]; then
      len_ge_8 "$gkey" || redir "" "Пароль гостевой сети: минимум 8 символов." ""
      is_ascii_nospace "$gkey" || redir "" "Пароль гостевой сети: только латиница, без пробелов." ""
    fi
    guest_enable "$gssid" "$gkey"
    redir "Гостевая сеть включена." "" ""
    ;;
  guest_disable)
    guest_disable
    redir "Гостевая сеть отключена." "" ""
    ;;
  parental_save)
    # DNS-фильтр
    DNS_ON="${FORM_action:-}"; DNS_ON="$(printf "%s" "${FORM_parental_dns:-0}" | strip_newlines)"
    DOMAINS="$(printf "%s" "${FORM_parental_domains:-}" | strip_newlines)"
    SCHED_ON="$(printf "%s" "${FORM_parental_sched:-0}" | strip_newlines)"
    TIME_OFF="$(printf "%s" "${FORM_parental_off:-22:00}" | strip_newlines)"
    TIME_ON="$(printf "%s" "${FORM_parental_on:-07:00}" | strip_newlines)"
    mkdir -p /etc/dnsmasq.d
    : > "$PARENTAL_CONF" 2>/dev/null || true
    if [ "$DNS_ON" = "1" ]; then
      parental_apply_dns
    else
      parental_remove_dns
    fi
    if [ -n "$DOMAINS" ]; then
      parental_apply_blocklist "$DOMAINS"
    fi
    if [ "$SCHED_ON" = "1" ]; then
      parental_apply_schedule "$TIME_OFF" "$TIME_ON" \
        || redir "" "Время указывайте в формате ЧЧ:ММ, например 22:00." ""
    else
      parental_remove_schedule
    fi
    redir "Родительский контроль сохранён." "" ""
    ;;
  parental_off)
    parental_remove_dns
    parental_remove_schedule
    : > "$PARENTAL_CONF" 2>/dev/null || true
    /etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
    redir "Родительский контроль отключён." "" ""
    ;;
esac

