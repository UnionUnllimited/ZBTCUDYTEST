/* ══════════════════════════════════════════════════════
   СВЕТЛАЯ ТЕМА — стиль Titan VPS
   ══════════════════════════════════════════════════════ */
[data-theme="light"]{
  --bg:#eef2f9;
  --s1:#ffffff;--s2:#f7f9fc;--s3:#edf0f7;
  --b1:#dde3ef;--b2:#c5cfe0;
  --txt:#0f172a;--mut:#3d4f6b;--dim:#64748b;
  --acc:#2563eb;--acc2:#1d4ed8;--acc3:#1e40af;
  --ok:#15803d;--bad:#dc2626;--warn:#b45309;
  --r:16px;--rs:12px;--rx:8px;
  --shadow-sm:0 1px 3px rgba(15,23,42,.08),0 1px 2px rgba(15,23,42,.04);
  --shadow-md:0 4px 16px rgba(15,23,42,.08),0 1px 4px rgba(15,23,42,.04);
  --shadow-lg:0 8px 32px rgba(15,23,42,.1),0 2px 8px rgba(15,23,42,.05);
}

/* ── Базовые элементы ── */
[data-theme="light"] body{background:var(--bg);color:var(--txt)}
[data-theme="light"] ::-webkit-scrollbar-thumb{background:#c5cfe0;border-radius:99px}

/* ── Фоновый паттерн страницы ── */
[data-theme="light"] body::before{
  content:'';position:fixed;inset:0;z-index:-1;
  background:
    radial-gradient(ellipse 80% 50% at 20% -10%,rgba(37,99,235,.07) 0%,transparent 60%),
    radial-gradient(ellipse 60% 40% at 90% 110%,rgba(29,78,216,.05) 0%,transparent 60%);
  pointer-events:none;
}

/* ── Шапка ── */
[data-theme="light"] .wrap{background:transparent}
[data-theme="light"] .panel-footer{color:#64748b}
[data-theme="light"] div[style*="background:var(--bg)"]{background:var(--bg) !important}
[data-theme="light"] body > div[style*="text-align:center"]{background:transparent !important}
[data-theme="light"] #burgerBtn{background:#fff;border-color:#dde3ef;color:#0f172a;box-shadow:var(--shadow-sm)}
[data-theme="light"] #burgerBtn.is-open{background:var(--acc);color:#fff;border-color:transparent;box-shadow:0 2px 8px rgba(37,99,235,.3)}
[data-theme="light"] .mchip{background:#fff;border-color:#dde3ef;color:#0f172a;box-shadow:var(--shadow-sm)}
[data-theme="light"] .copyid{color:#0f172a;font-weight:700}
[data-theme="light"] .copybtn{background:#f1f5f9;border-color:#dde3ef;color:#374151}
[data-theme="light"] .copybtn:hover{background:#e2e8f0}

/* ── Карточки ── */
[data-theme="light"] .card{
  background:#fff;border-color:#dde3ef;
  box-shadow:var(--shadow-sm);
}
[data-theme="light"] .card:hover{border-color:#c5cfe0;box-shadow:var(--shadow-md)}
[data-theme="light"] .card-title{color:#0f172a;font-weight:700}

/* ── Статус-бар чипы (si) ── */
[data-theme="light"] .si{
  background:#fff;border-color:#dde3ef;
  box-shadow:var(--shadow-sm);
}
[data-theme="light"] .si:hover{border-color:#c5cfe0;box-shadow:var(--shadow-md)}
[data-theme="light"] .si-left{background:#f7f9fc;border-right:1px solid #dde3ef}
[data-theme="light"] .sname{color:#374151;font-weight:600}
[data-theme="light"] .sval{color:#0f172a;font-weight:800}

/* ── Аккордеоны (расширенные настройки) ── */
[data-theme="light"] .adv-wrap{
  background:#fff;border-color:#dde3ef;
  box-shadow:var(--shadow-sm);
}
[data-theme="light"] .adv-wrap:hover{border-color:#c5cfe0}
[data-theme="light"] .adv-hdr{background:#fff}
[data-theme="light"] .adv-hdr:hover{background:#f7f9fc}
[data-theme="light"] .adv-title{color:#0f172a;font-weight:800}
[data-theme="light"] .adv-sub{color:#64748b}
[data-theme="light"] .adv-body{background:#f7f9fc;border-top:1px solid #dde3ef}
[data-theme="light"] .adv-inner{background:#f7f9fc}

/* ── Внутренние аккордеоны (acc) ── */
[data-theme="light"] .acc-hdr{border-color:#dde3ef;background:#fff}
[data-theme="light"] .acc-hdr:hover{background:#f1f5f9}
[data-theme="light"] .acc-title{color:#0f172a;font-weight:700}
[data-theme="light"] .acc-body{background:#fff;border:1px solid #dde3ef;border-top:none;border-radius:0 0 var(--rs) var(--rs)}
[data-theme="light"] .acc-inner{background:#fff}
[data-theme="light"] .acc-grid{background:#fff}

/* ── Поля ввода ── */
[data-theme="light"] input,[data-theme="light"] select,[data-theme="light"] textarea{
  background:#fff;border-color:#dde3ef;color:#0f172a;
  box-shadow:inset 0 1px 3px rgba(15,23,42,.05);
}
[data-theme="light"] input:focus,[data-theme="light"] select:focus,[data-theme="light"] textarea:focus{
  border-color:var(--acc);box-shadow:0 0 0 3px rgba(37,99,235,.12),inset 0 1px 2px rgba(15,23,42,.03);
}
[data-theme="light"] label{color:#374151 !important;font-weight:600}
[data-theme="light"] select option{background:#fff;color:#0f172a}

/* ── Кнопки ── */
[data-theme="light"] .btn{border-color:#dde3ef}
[data-theme="light"] .btn.secondary{background:#fff;border-color:#dde3ef;color:#0f172a;box-shadow:var(--shadow-sm)}
[data-theme="light"] .btn.secondary:hover{background:#f1f5f9;border-color:#c5cfe0}
[data-theme="light"] .btn.primary{box-shadow:0 2px 8px rgba(37,99,235,.25)}
[data-theme="light"] .btn.primary:hover{box-shadow:0 4px 16px rgba(37,99,235,.35)}

/* ── Текст и метки ── */
[data-theme="light"] .ir-label{color:#475569;font-weight:600}
[data-theme="light"] .ir-val{color:#0f172a;font-weight:700}
[data-theme="light"] .ir-row{border-bottom-color:#edf0f7}
[data-theme="light"] small,[data-theme="light"] .hint{color:#64748b}
[data-theme="light"] .badge-ok{color:#15803d;background:rgba(21,128,61,.1);border-color:rgba(21,128,61,.2)}
[data-theme="light"] .badge-bad{color:#dc2626;background:rgba(220,38,38,.08);border-color:rgba(220,38,38,.18)}
[data-theme="light"] .live-dot{box-shadow:0 0 0 3px rgba(21,128,61,.18)}

/* ── Сообщения ── */
[data-theme="light"] .msg,.okline{border-color:rgba(21,128,61,.2);background:rgba(21,128,61,.07);color:#15803d}
[data-theme="light"] .err,.badline{border-color:rgba(220,38,38,.18);background:rgba(220,38,38,.06);color:#dc2626}

/* ── Боковая панель (nav) ── */
[data-theme="light"] #navOverlay{background:rgba(15,23,42,.35)}
[data-theme="light"] .nav{
  background:#fff;border-right:1px solid #dde3ef;
  box-shadow:8px 0 32px rgba(15,23,42,.1);
}
[data-theme="light"] .nav-header{border-bottom-color:#dde3ef;background:#f7f9fc}
[data-theme="light"] .nav-close{background:#fff;border-color:#dde3ef;color:#475569}
[data-theme="light"] .nav-close:hover{background:#f1f5f9}
[data-theme="light"] .nav-sep{background:#dde3ef}
[data-theme="light"] .nav-section-label{color:#94a3b8;font-size:10px;letter-spacing:.8px}
[data-theme="light"] .nav a,[data-theme="light"] .nav button{color:#1e293b}
[data-theme="light"] .nav a:hover,[data-theme="light"] .nav button:hover{background:#f1f5f9}
[data-theme="light"] .nav a:active,[data-theme="light"] .nav button:active{background:#e8edf5}
[data-theme="light"] .nav a.primary,[data-theme="light"] .nav button.primary{color:#fff;box-shadow:0 2px 8px rgba(37,99,235,.2)}
[data-theme="light"] .nav a.primary:hover,[data-theme="light"] .nav button.primary:hover{
  background:linear-gradient(135deg,var(--acc),var(--acc2),var(--acc3));
  color:#fff;
  box-shadow:0 4px 14px rgba(37,99,235,.3);
}
[data-theme="light"] .nav-home-btn{color:var(--acc) !important;background:#eff6ff !important;border:1px solid #bfdbfe !important}
[data-theme="light"] .nav-home-btn:hover{background:#dbeafe !important}
[data-theme="light"] .nav-theme-btn{color:#64748b !important}

/* ── Заголовок Titan Router ── */
[data-theme="light"] #atlTitle{
  background:linear-gradient(135deg,#2563eb 0%,#1d4ed8 50%,#7c3aed 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
[data-theme="light"] .nav-header-title{
  background:linear-gradient(135deg,var(--acc),var(--acc2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}

/* ── Wizard в светлой теме ── */
[data-theme="light"] #wizOverlay{background:rgba(15,23,42,.5)}
[data-theme="light"] .wiz-box{background:#fff;border-color:#dde3ef;box-shadow:var(--shadow-lg)}
[data-theme="light"] .wiz-title{color:#0f172a}
[data-theme="light"] .wiz-desc{color:#475569}
[data-theme="light"] .wiz-progress{background:#edf0f7}
[data-theme="light"] .wiz-band-tabs{background:#f1f5f9;border-color:#dde3ef}
[data-theme="light"] .wiz-band{color:#64748b}
[data-theme="light"] .wiz-skip{color:#94a3b8}
[data-theme="light"] .wiz-skip:hover{color:#475569}
[data-theme="light"] #wizOverlay{background:rgba(15,23,42,.45)}
[data-theme="light"] .wiz-box{background:var(--s1);border-color:var(--b1);box-shadow:0 16px 48px rgba(0,0,0,.15)}
[data-theme="light"] .wiz-step{color:var(--txt)}
[data-theme="light"] .wiz-desc{color:var(--mut)}
[data-theme="light"] .wiz-progress{background:var(--s3)}
[data-theme="light"] .wiz-band-tabs{background:var(--s3);border-color:var(--b1)}
[data-theme="light"] .wiz-band{color:var(--dim)}
[data-theme="light"] .wiz-skip{color:var(--dim)}
/* ── Nav utility кнопки ─────────────────────────────── */
.nav-home-btn{
  background:var(--s2);border:1px solid var(--b2) !important;
  font-weight:700 !important;color:var(--acc) !important;
  border-radius:10px !important;
}
.nav-home-btn:hover{background:var(--s3) !important}
.nav-theme-btn{color:var(--dim) !important;font-size:12px !important;font-weight:600 !important}
/* ── Wizard (мастер первого запуска) ────────────────── */
#wizOverlay{
  display:none;position:fixed;inset:0;z-index:500;
  background:rgba(0,0,0,.82);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
  align-items:center;justify-content:center;padding:16px;
}
#wizOverlay.on{display:flex}
.wiz-box{
  width:100%;max-width:460px;
  background:var(--s1);border:1px solid var(--b2);
  border-radius:24px;overflow:hidden;
  animation:fadeUp .3s ease both;
}
.wiz-progress{height:3px;background:var(--b1)}
.wiz-progress-bar{height:3px;background:linear-gradient(90deg,var(--acc),var(--acc2));transition:width .4s ease}
.wiz-step{display:none;padding:28px 24px 24px;flex-direction:column;gap:16px}
.wiz-step.active{display:flex}
.wiz-icon{font-size:36px;text-align:center}
.wiz-title{font-size:18px;font-weight:800;letter-spacing:-.3px;text-align:center}
.wiz-desc{font-size:13px;color:var(--mut);text-align:center;line-height:1.6}
.wiz-field{display:flex;flex-direction:column;gap:6px}
.wiz-field label{font-size:12px;font-weight:700;color:var(--dim);text-transform:uppercase;letter-spacing:.4px}
.wiz-actions{display:flex;gap:8px;margin-top:4px}
.wiz-actions .btn{flex:1}
.wiz-skip{background:none;border:none;color:var(--dim);font-size:12px;text-align:center;cursor:pointer;padding:4px;text-decoration:underline}
.wiz-skip:hover{color:var(--txt)}
#wizWanPPP,#wizWanStatic{flex-direction:column;gap:10px}
.wiz-band-tabs{display:flex;background:var(--s2);border:1px solid var(--b1);border-radius:10px;padding:3px;gap:3px}
.wiz-band{flex:1;padding:7px 0;border-radius:7px;border:none;background:transparent;color:var(--mut);font-size:13px;font-weight:600;cursor:pointer;transition:background .15s,color .15s}
.wiz-band.active{background:var(--acc);color:#fff;box-shadow:0 1px 6px rgba(37,99,235,.3)}

@keyframes _spin{to{transform:rotate(360deg)}}
#loadingOverlay{display:none;position:fixed;inset:0;z-index:9000;background:rgba(0,0,0,.75);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);align-items:center;justify-content:center;flex-direction:column;gap:18px}
#loadingOverlay.on{display:flex !important}
.ld-ring{width:56px;height:56px;border:4px solid rgba(255,255,255,.12);border-top-color:var(--acc);border-radius:50%;animation:_spin .75s linear infinite}
.ld-text{font-size:16px;font-weight:700;color:#fff;text-align:center;max-width:280px;line-height:1.5}
.ld-sub{font-size:12px;color:rgba(255,255,255,.5);text-align:center;max-width:280px;margin-top:-10px}
</style>
</head>
<body>
<div id="loadingOverlay">
  <div class="ld-ring"></div>
  <div class="ld-text" id="ld-text">Выполняется…</div>
  <div class="ld-sub" id="ld-sub"></div>
</div>


<!-- ══ Мастер первого запуска ═══════════════════════════════ -->
<div id="wizOverlay">
  <div class="wiz-box">
    <div class="wiz-progress"><div class="wiz-progress-bar" id="wizBar" style="width:0%"></div></div>

    <!-- Шаг 0: Добро пожаловать -->
    <div class="wiz-step active" id="wiz0">
      <div class="wiz-icon">🚀</div>
      <div class="wiz-title">Добро пожаловать в Titan Router!</div>
      <div class="wiz-desc">Настроим роутер за 3 шага:<br>📶 WiFi → 🌐 Интернет → 🔐 Пароль</div>
      <div class="wiz-actions">
        <button class="btn primary" type="button" onclick="wizNext()">Начать настройку →</button>
      </div>
      <a href="/instruction.html" style="display:block;margin-top:8px;font-size:12px;color:var(--acc);text-align:center;text-decoration:underline">Прочитать инструкцию перед началом</a>
      <button class="wiz-skip" type="button" onclick="wizFinish(true)">Пропустить, настрою позже</button>
    </div>

    <!-- Шаг 1: WiFi -->
    <div class="wiz-step" id="wiz1">
      <div class="wiz-icon">📶</div>
      <div class="wiz-title">Настройка WiFi</div>
      <div class="wiz-desc">Префикс <b>Titan-</b> добавится автоматически.<br>Пароль один для обеих сетей.</div>
      <div class="wiz-band-tabs">
        <button type="button" class="wiz-band active" id="wizBand24Btn" onclick="wizBandSwitch('24')">2.4 ГГц</button>
        <button type="button" class="wiz-band" id="wizBand5Btn" onclick="wizBandSwitch('5')">5 ГГц</button>
      </div>
      <!-- 2.4 ГГц -->
      <div id="wizBand24">
        <div class="wiz-field">
          <label>Имя сети 2.4 ГГц (SSID)</label>
          <div style="display:flex;align-items:center;gap:0">
            <span style="background:var(--s3);border:1px solid var(--b1);border-right:0;border-radius:8px 0 0 8px;padding:9px 10px;font-size:13px;font-weight:700;color:var(--acc);white-space:nowrap;min-height:40px;display:flex;align-items:center;flex-shrink:0">Titan-</span>
            <input class="inp" id="wizSsid" type="text" placeholder="MyHome" autocomplete="off" spellcheck="false" style="border-radius:0 8px 8px 0;flex:1;margin:0">
          </div>
        </div>
        <div class="wiz-field">
          <label>Пароль (мин. 8 символов)</label>
          <div class="pw-wrap">
            <input class="inp" id="wizKey" type="password" placeholder="Минимум 8 символов" autocomplete="new-password">
            <button class="pw-eye" type="button" onclick="togglePw('wizKey')">👁</button>
          </div>
        </div>
      </div>
      <!-- 5 ГГц -->
      <div id="wizBand5" style="display:none">
        <div class="wiz-field">
          <label>Имя сети 5 ГГц (SSID)</label>
          <div style="display:flex;align-items:center;gap:0">
            <span style="background:var(--s3);border:1px solid var(--b1);border-right:0;border-radius:8px 0 0 8px;padding:9px 10px;font-size:13px;font-weight:700;color:var(--acc);white-space:nowrap;min-height:40px;display:flex;align-items:center;flex-shrink:0">Titan-</span>
            <input class="inp" id="wizSsid5" type="text" placeholder="MyHome-5G" autocomplete="off" spellcheck="false" style="border-radius:0 8px 8px 0;flex:1;margin:0">
          </div>
        </div>
        <div class="wiz-field">
          <label>Пароль (мин. 8 символов)</label>
          <div class="pw-wrap">
            <input class="inp" id="wizKey5" type="password" placeholder="Минимум 8 символов" autocomplete="new-password">
            <button class="pw-eye" type="button" onclick="togglePw('wizKey5')">👁</button>
          </div>
        </div>
        <div style="font-size:11px;color:var(--dim);text-align:center;margin-top:2px">Если оставить пустым — скопируется из 2.4 ГГц</div>
      </div>
      <div id="wizWifiErr" style="color:var(--bad);font-size:12px;display:none"></div>
      <div class="wiz-actions">
        <button class="btn secondary" type="button" onclick="wizPrev()">← Назад</button>
        <button class="btn primary" type="button" onclick="wizNext()">Далее →</button>
      </div>
      <button class="wiz-skip" type="button" onclick="wizNext(true)">Пропустить этот шаг</button>
    </div>

    <!-- Шаг 2: WAN / Интернет -->
    <div class="wiz-step" id="wiz2">
      <div class="wiz-icon">🌐</div>
      <div class="wiz-title">Подключение к интернету</div>
      <div class="wiz-desc">Выберите тип подключения вашего провайдера.</div>
      <div class="wiz-field">
        <label>Тип подключения</label>
        <select class="inp" id="wizWanProto" onchange="wizWanChange()">
          <option value="dhcp">DHCP — автоматически (чаще всего)</option>
          <option value="pppoe">PPPoE — логин и пароль провайдера</option>
          <option value="static">Static IP — статический адрес</option>
          <option value="l2tp">L2TP</option>
          <option value="pptp">PPTP</option>
        </select>
      </div>
      <!-- PPPoE / L2TP / PPTP -->
      <div id="wizWanPPP" style="display:none;flex-direction:column;gap:10px">
        <div class="wiz-field">
          <label>Логин провайдера</label>
          <input class="inp" id="wizPppUser" type="text" placeholder="login@provider.ru" autocomplete="off" spellcheck="false">
        </div>
        <div class="wiz-field">
          <label>Пароль провайдера</label>
          <div class="pw-wrap">
            <input class="inp" id="wizPppPass" type="password" placeholder="Пароль" autocomplete="new-password">
            <button class="pw-eye" type="button" onclick="togglePw('wizPppPass')">👁</button>
          </div>
        </div>
        <div id="wizL2tpServerWrap" class="wiz-field" style="display:none">
          <label>Адрес сервера (VPN-адрес провайдера)</label>
          <input class="inp" id="wizL2tpServer" type="text" placeholder="vpn.provider.ru или 1.2.3.4" autocomplete="off">
        </div>
      </div>
      <!-- Static IP -->
      <div id="wizWanStatic" style="display:none;flex-direction:column;gap:10px">
        <div class="wiz-field">
          <label>IP адрес</label>
          <input class="inp" id="wizStaticIp" type="text" placeholder="192.168.1.100" autocomplete="off">
        </div>
        <div class="wiz-field">
          <label>Маска подсети</label>
          <input class="inp" id="wizStaticMask" type="text" placeholder="255.255.255.0" autocomplete="off" value="255.255.255.0">
        </div>
        <div class="wiz-field">
          <label>Шлюз</label>
          <input class="inp" id="wizStaticGw" type="text" placeholder="192.168.1.1" autocomplete="off">
        </div>
        <div class="wiz-field">
          <label>DNS (необязательно)</label>
          <input class="inp" id="wizStaticDns" type="text" placeholder="8.8.8.8" autocomplete="off">
        </div>
      </div>
      <div id="wizWanErr" style="color:var(--bad);font-size:12px;display:none"></div>
      <div class="wiz-actions">
        <button class="btn secondary" type="button" onclick="wizPrev()">← Назад</button>
        <button class="btn primary" type="button" onclick="wizNext()">Далее →</button>
      </div>
      <button class="wiz-skip" type="button" onclick="wizNext(true)">Пропустить этот шаг</button>
    </div>

    <!-- Шаг 3: Пароль панели -->
    <div class="wiz-step" id="wiz3">
      <div class="wiz-icon">🔐</div>
      <div class="wiz-title">Пароль панели управления</div>
      <div class="wiz-desc">Смените стандартный <b>admin / admin</b> на свой.<br>Это защитит панель от посторонних.</div>
      <div class="wiz-field">
        <label>Логин</label>
        <input class="inp" id="wizUser" type="text" placeholder="Минимум 5 символов" autocomplete="off" spellcheck="false" value="admin">
      </div>
      <div class="wiz-field">
        <label>Новый пароль (мин. 8 символов)</label>
        <div class="pw-wrap">
          <input class="inp" id="wizPass" type="password" placeholder="Минимум 8 символов" autocomplete="new-password">
          <button class="pw-eye" type="button" onclick="togglePw('wizPass')">👁</button>
        </div>
      </div>
      <div id="wizCredsErr" style="color:var(--bad);font-size:12px;display:none"></div>
      <div class="wiz-actions">
        <button class="btn secondary" type="button" onclick="wizPrev()">← Назад</button>
        <button class="btn primary" type="button" onclick="wizNext()">Сохранить и завершить</button>
      </div>
      <button class="wiz-skip" type="button" onclick="wizFinish(false)">Оставить admin/admin (небезопасно)</button>
    </div>
  </div>
</div>

<!-- Предупреждение о дефолтном пароле -->
<div id="modal" style="position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.55);backdrop-filter:blur(6px);z-index:300;padding:16px" onclick="modalClose()">
  <div style="max-width:480px;width:100%;background:var(--s1);border:1px solid var(--b2);border-radius:20px;padding:24px;animation:fadeUp .3s ease;box-shadow:0 8px 40px rgba(0,0,0,.18)" onclick="event.stopPropagation()">
    <h3 style="margin:0 0 10px;font-size:16px;color:var(--txt)">⚠️ Смените данные для входа</h3>
    <p style="margin:0 0 16px;color:var(--mut);line-height:1.6">Сейчас установлены стандартные данные: <b style="color:var(--txt)">admin / admin</b>. Перейдите в раздел <b style="color:var(--txt)">«Доступ к панели управления»</b> в расширенных настройках и задайте свои значения.</p>
    <button class="btn primary" type="button" onclick="modalClose()" style="width:100%">Понятно</button>
  </div>
</div>

<div style="width:100%;text-align:center;padding:20px 0 4px;background:var(--bg)">
  <div id="atlTitle" style="font-size:32px;font-weight:800;letter-spacing:-1.5px;background:linear-gradient(135deg,var(--acc),var(--acc2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1.1">Titan Router</div>
</div>
<div class="wrap">
  <div class="header">
    <button id="burgerBtn" type="button" onclick="menuToggle()" aria-label="Меню" autocomplete="off">☰</button>
    <div class="meta-chips" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:center">
      <div class="mchip mchip-mac">
        <span style="color:var(--dim);font-size:11px;margin-right:2px">MAC</span>
        <span id="deviceid" class="copyid">${ES_MAC}</span>
        <button class="copybtn" type="button" onclick="copyText('deviceid')" style="padding:4px 8px;min-height:28px;font-size:11px">📋</button>
        <span id="copied" class="toast">✓</span>
      </div>
      <div class="mchip" id="vpn-hdr-chip" onclick="pact('${BYPASS_ACT}')" style="cursor:pointer;gap:6px" title="Нажмите для переключения VPN">
        <span class="sdot ${BYPASS_DOT}" id="sdot-bypass-hdr"></span>
        <span style="font-size:11px;font-weight:700">VPN</span>
        <span style="font-size:11px;color:var(--dim)" id="sv-bypass-hdr">${BYPASS_LABEL}</span>
      </div>
    </div>
    <div></div><!-- grid col 3: spacer для симметрии -->
  </div>

  <!-- ── Overlay (закрывает sidebar при клике вне) ── -->
  <div id="navOverlay" onclick="menuClose()"></div>

  <!-- ── Навигация — боковая панель ── -->
  <nav class="nav" id="mainNav" role="navigation" aria-label="Главное меню">
    <div class="nav-header">
      <span class="nav-header-title">Titan Router</span>
      <button class="nav-close" type="button" onclick="menuClose()" aria-label="Закрыть">✕</button>
    </div>
    <div class="nav-items">
      <button type="button" class="nav-home-btn" onclick="goHome()">Главное меню</button>
      <div class="nav-sep"></div>
      <span class="nav-section-label">Сервисы</span>
      <a class="primary" href="javascript:void(0)" onclick="menuBlank('${LINK_SUB}')">Подписка</a>
      <a href="javascript:void(0)" onclick="menuBlank('${LINK_SUPPORT}')">Поддержка</a>
      <a href="javascript:void(0)" onclick="menuBlank('/instruction.html')">Инструкция</a>
      <div class="nav-sep"></div>
      <span class="nav-section-label">Управление</span>
      <button type="button" onclick="pact('restart_inet')">Перезапустить интернет</button>
      <button class="primary" type="button" onclick="pact('passwall_update')">Обновить подписку</button>
      <button type="button" id="navBypassBtn" onclick="pact('${BYPASS_ACT}')" data-act="${BYPASS_ACT}">${BYPASS_BTN}</button>
      <div class="nav-sep"></div>
      <button type="button" onclick="otaOpenMenu()">Обновить роутер</button>
      <button type="button" onclick="advOpenMenu()">Расширенные настройки</button>
