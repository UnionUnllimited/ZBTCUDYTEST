#!/bin/sh
printf "Content-Type: application/json\r\n"
printf "Access-Control-Allow-Origin: *\r\n"
printf "\r\n"
cpu1=$(cat /proc/stat | head -1); sleep 1; cpu2=$(cat /proc/stat | head -1)
total1=$(echo $cpu1 | awk '{print $2+$3+$4+$5+$6+$7+$8}'); idle1=$(echo $cpu1 | awk '{print $5}')
total2=$(echo $cpu2 | awk '{print $2+$3+$4+$5+$6+$7+$8}'); idle2=$(echo $cpu2 | awk '{print $5}')
dtotal=$((total2-total1)); didle=$((idle2-idle1))
[ "$dtotal" -gt 0 ] && cpu_pct=$(( (dtotal-didle)*100/dtotal )) || cpu_pct=0
mem_total=$(awk '/MemTotal/{print $2}' /proc/meminfo)
mem_free=$(awk '/MemFree/{print $2}' /proc/meminfo)
mem_buf=$(awk '/Buffers/{print $2}' /proc/meminfo)
mem_cache=$(awk '/^Cached/{print $2}' /proc/meminfo)
mem_used=$((mem_total-mem_free-mem_buf-mem_cache)); ram_pct=$((mem_used*100/mem_total))
uptime_sec=$(awk '{print int($1)}' /proc/uptime)
load=$(awk '{print $1}' /proc/loadavg)
wan_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '/src/{print $7}'); [ -z "$wan_ip" ] && wan_ip="unknown"
node=$(uci -q get passwall.@global[0].tcp_node 2>/dev/null)
vpn_ip=$([ -n "$node" ] && uci -q get passwall.${node}.address 2>/dev/null || echo "")
wan_dev=$(uci -q get network.wan.device 2>/dev/null)
[ -n "$wan_dev" ] || wan_dev=$(ip route get 1.1.1.1 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1)
[ -n "$wan_dev" ] || wan_dev=eth0
rx_bytes=$(cat "/sys/class/net/$wan_dev/statistics/rx_bytes" 2>/dev/null || echo 0)
tx_bytes=$(cat "/sys/class/net/$wan_dev/statistics/tx_bytes" 2>/dev/null || echo 0)
vpn_running=false; [ "$(uci get passwall.@global[0].enabled 2>/dev/null)" = "1" ] && vpn_running=true
bypass_on=false; pgrep -f nfqws >/dev/null 2>&1 && bypass_on=true
wifi_clients=0; for iface in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do n=$(iw dev "$iface" station dump 2>/dev/null | grep -c Station); wifi_clients=$((wifi_clients+n)); done
dhcp_clients=0; [ -f /tmp/dhcp.leases ] && dhcp_clients=$(wc -l < /tmp/dhcp.leases)
temp=null; for f in /sys/class/thermal/thermal_zone*/temp; do [ -f "$f" ] && temp=$(awk '{printf "%.1f",$1/1000}' "$f") && break; done
mac=$(cat /sys/class/net/br-lan/address 2>/dev/null || echo "00:00:00:00:00:00")
fw=$(grep DISTRIB_RELEASE /etc/openwrt_release 2>/dev/null | cut -d= -f2 | tr -d "\"'")
board=$(cat /tmp/sysinfo/board_name 2>/dev/null || echo "unknown")
frpc_running=false; pgrep -f frpc >/dev/null 2>&1 && frpc_running=true
# Номер сборки прошивки. Панель сравнивает его с version из манифеста,
# поэтому нужно целое, а не человекочитаемое 25.12.3. Нет файла или в
# нём мусор — отдаём null: "не сообщил" и "нулевая сборка" это разное.
titan_build=$(cat /etc/titan_version 2>/dev/null | tr -dc '0-9')
[ -n "$titan_build" ] || titan_build=null
# Итог последнего похода за манифестом: ok, no_update, update_available,
# not_in_rollout, no_image, download_failed, sha_mismatch, flash_failed.
ota_status=$(awk '{print $1}' /etc/titan_ota_status 2>/dev/null)
[ -n "$ota_status" ] && ota_status="\"$ota_status\"" || ota_status=null
ota_at=$(awk '{print $2}' /etc/titan_ota_status 2>/dev/null | tr -dc '0-9')
[ -n "$ota_at" ] || ota_at=null
printf '{"mac":"%s","board":"%s","fw":"%s","uptime_sec":%s,"load":%s,"cpu_pct":%s,"ram":{"total_kb":%s,"used_kb":%s,"pct":%s},"temp_c":%s,"network":{"wan_ip":"%s","vpn_ip":"%s","rx_bytes":%s,"tx_bytes":%s},"clients":{"wifi":%s,"dhcp":%s},"vpn_active":%s,"bypass_on":%s,"frpc_running":%s,"titan_build":%s,"titan_update_status":%s,"titan_update_at":%s,"ts":%s}\n' "$mac" "$board" "$fw" "$uptime_sec" "$load" "$cpu_pct" "$mem_total" "$mem_used" "$ram_pct" "$temp" "$wan_ip" "$vpn_ip" "$rx_bytes" "$tx_bytes" "$wifi_clients" "$dhcp_clients" "$vpn_running" "$bypass_on" "$frpc_running" "$titan_build" "$ota_status" "$ota_at" "$(date +%s)"

