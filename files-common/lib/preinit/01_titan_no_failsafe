# Titan Router — аварийный режим отключён
#
# Failsafe даёт root без пароля любому, у кого роутер в руках: зажал
# reset при загрузке — и система поднимается с несмонтированным оверлеем
# и полным доступом. Ни пароль root, ни пароль панели там не спрашиваются.
# Для устройства, стоящего у клиента, это открытая дверь.
#
# Флаг читается в /lib/preinit/30_failsafe_wait. При значении "y"
# функция failsafe_wait выходит ДО всех трёх способов входа: до проверки
# failsafe= в командной строке ядра, до клавиши f с консоли и до
# /tmp/failsafe_button от кнопки reset.
#
# Файл отдельный, а не правка 00_preinit.conf: preinit подключает всё
# содержимое /lib/preinit/ по порядку имён, и 01_ читается после 00_.
# Значит дефолты пакета остаются нетронутыми и переживут обновление
# base-files, а мы лишь переопределяем одно значение.
#
# ЦЕНА. Failsafe — последний способ вернуть роутер, у которого не
# поднялась прошивка или разъехался конфиг. После этой правки такой
# случай лечится только TFTP через загрузчик или пайкой USB-TTL, то есть
# выездом к клиенту. Перед раскаткой на парк стоит убедиться, что
# восстановление через загрузчик на всех четырёх моделях у вас отработано.
#
# Кнопка reset в обычном режиме продолжает работать: обработчик
# /etc/hotplug.d/button/00-atlanta сбрасывает пароль панели, это другой
# механизм и он не затронут.
pi_preinit_no_failsafe="y"

# Ожидание клавиш при загрузке теперь ни на что не влияет — failsafe
# всё равно не включится, а выбор уровня отладки на проданном роутере
# не нужен. Сокращаем с четырёх секунд до одной.
fs_failsafe_wait_timeout=1
